{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "training_expiry_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_and_notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "trainingExpiryAlert",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan expiring training",
            "description": "Emails each staff member and their supervisor 30 days before their certification expires"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Training Expiry Alerts",
  "description": "Daily at 9am: emails staff and their supervisor whose training certifications expire in exactly 30 days."
}