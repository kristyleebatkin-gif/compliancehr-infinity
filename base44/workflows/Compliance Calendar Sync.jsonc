{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "compliance_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_deadlines": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "complianceCalendarSync"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync deadlines to Google Calendar",
            "description": "Create, update and remove task deadline events"
          }
        }
      }
    ]
  },
  "name": "Compliance Calendar Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "45 6 * * *",
      "one_time_date": null,
      "timezone": "Australia/Sydney",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Syncs all active compliance task deadlines into Google Calendar as all-day events so nothing expires unnoticed"
}