{
  "name": "Compliance Task Expiry Alerts",
  "description": "Daily at 7am (Brisbane): alerts staff immediately when their compliance tasks or worker screenings are due or overdue, by email plus in-app notification.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "compliance_task_expiry_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_expiry_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "complianceTaskExpiryAlerts",
            "args": {}
          },
          "then": "screening_alerts",
          "x-base44": {
            "title": "Send task expiry alerts",
            "description": "Emails and in-app alerts assignees of active compliance tasks that are nearing or past their due date"
          }
        }
      },
      {
        "screening_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "screeningExpiryAlerts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send worker screening alerts",
            "description": "Emails and in-app alerts staff whose NDIS worker screening is expired or due within 30 days"
          }
        }
      }
    ]
  }
}