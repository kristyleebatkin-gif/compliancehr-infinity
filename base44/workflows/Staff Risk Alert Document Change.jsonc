{
  "name": "Staff Risk Alert Document Change",
  "description": "The moment an employee document is created or changed, scores every staff member's compliance risk and instantly notifies admins in-app for anyone whose risk score exceeds the threshold.",
  "trigger": {
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; (IN(\"tenant_id\", \"updated_date\", \"created_by_id\", \"created_by\", \"is_sample\") | not))) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EmployeeDocument"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "staff_risk_alert_document_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_risk_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "staffRiskThresholdAlert",
            "args": {
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check risk thresholds",
            "description": "Alerts admins when a staff risk score exceeds the threshold"
          }
        }
      }
    ]
  }
}
