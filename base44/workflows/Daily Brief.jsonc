{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_brief",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "build_brief": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyBrief",
            "args": {
              "notify": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Build and email the 8:30 AM daily summary brief",
            "description": "Org-wide snapshot of expiries, overdue tasks, incidents, risks and unfilled shifts"
          }
        }
      }
    ]
  },
  "description": "Daily at 8:30 AM (Australia/Brisbane): morning summary brief of expiries, overdue tasks, incidents, risks and unfilled shifts emailed and notified to administrators",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 8 * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Brief"
}