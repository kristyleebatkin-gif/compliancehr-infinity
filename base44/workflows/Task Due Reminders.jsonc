            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send due task reminders",
            "description": "Emails everyone responsible for pending shared to-dos that are due today or overdue"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Task Due Reminders",
  "description": "Daily at 7am: emails a reminder to every person responsible for a pending shared to-do that is due today or overdue."
