{
  "name": "Procurement Order Alerts",
  "description": "Notifies management and finance staff whenever a purchase order is created or its status changes",
  "trigger": {
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; . != \"tenant_id\" and . != \"updated_date\")) and (.trigger.event_type == \"create\" or (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PurchaseOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "procurement_order_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "alert_management": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "procurementAlert",
            "args": {
              "po_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify management",
            "description": "Emails management and finance staff about the order"
          }
        }
      }
    ]
  }
}