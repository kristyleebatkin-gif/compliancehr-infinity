{
  "description": "When a leave request is entered in the HR Hub, logs it to the audit log and notifies admin staff by email.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LeaveRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "leave_request_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_admins": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "leaveRequestAlert",
            "args": {
              "leave_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log leave and notify admins",
            "description": "Emails admin staff the new leave request"
          }
        }
      }
    ]
  },
  "name": "Leave Request Alerts"
}