{
  "name": "Offboarding Task Pack",
  "description": "When a staff profile is set to Inactive, generates the offboarding task pack (exit, property, access, final pay, handover)",
  "trigger": {
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; (IN(\"tenant_id\", \"updated_date\", \"created_by_id\", \"created_by\", \"is_sample\") | not))) and (.trigger.data.status == \"Inactive\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "StaffProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "offboarding_task_pack",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_pack": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "staffPack",
            "args": {
              "kind": "offboarding",
              "entity_id": "${ .trigger.entity_id }",
              "staff_name": "${ .trigger.data.full_name // \"\" }",
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate offboarding pack",
            "description": "Creates exit and handover to-dos"
          }
        }
      }
    ]
  }
}
