{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_route_meetings",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "route_entry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRouteEntry",
            "args": {
              "entity": "Meeting",
              "record_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }",
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "File to Meeting Minutes Register",
            "description": "Auto-route new meeting"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Meeting"
    }
  },
  "description": "Files every new meeting into the Meeting Minutes Register automatically",
  "name": "Auto Route: Meetings"
}
