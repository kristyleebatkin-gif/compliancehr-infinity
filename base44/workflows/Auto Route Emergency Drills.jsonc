{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_route_emergency_drills",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "route_entry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRouteEntry",
            "args": {
              "token": "a7f3d9c2e8b14f6a0d5c9e2b7f4a1c8e3d6b9f2a5c8e1d4b7a9f3c6e2d5b8a1f",
              "entity": "EmergencyDrill",
              "record_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "File to Emergency Drill Register",
            "description": "Auto-route new drill"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "EmergencyDrill"
    }
  },
  "description": "Files every new emergency drill into the Emergency Drill Register automatically",
  "name": "Auto Route: Emergency Drills"
}