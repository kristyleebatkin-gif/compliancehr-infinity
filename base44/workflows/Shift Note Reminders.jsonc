{
  "name": "Shift Note Reminders",
  "description": "Daily at 7pm Australia/Sydney: employee reminders on days 1-5 after shift end; manager escalation from day 6. Delivery and matching require validation.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 19 * * *",
      "one_time_date": null,
      "timezone": "Australia/Sydney",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "shift_note_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind_missing_notes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "shiftNoteReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep overdue shift notes",
            "description": "Daily reminder for completed shifts without a note"
          }
        }
      }
    ]
  }
}