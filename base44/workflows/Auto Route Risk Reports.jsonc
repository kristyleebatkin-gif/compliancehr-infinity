{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_route_risks",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "route_entry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRouteEntry",
            "args": {
              "entity": "Risk",
              "record_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }",
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "File risk report",
            "description": "Auto-route risk, hazard or near miss"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Risk"
    }
  },
  "description": "Files every new risk report into the matching Risk, Hazard or Near Miss Register, escalating High and Critical ratings",
  "name": "Auto Route: Risk Reports"
}
