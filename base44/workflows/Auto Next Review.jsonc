{
  "name": "Auto Next Review",
  "description": "When a performance review is completed, sets the next review date by cadence and creates a follow-up review reminder task",
  "trigger": {
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; (IN(\"tenant_id\", \"updated_date\", \"created_by_id\", \"created_by\", \"is_sample\") | not))) and (.trigger.data.status == \"Completed\" and not .trigger.data.next_review_date) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PerformanceReview"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_next_review",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "schedule_next_review": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoNextReview",
            "args": {
              "entity_id": "${ .trigger.entity_id }",
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Schedule next review",
            "description": "Sets next review date and follow-up task"
          }
        }
      }
    ]
  }
}
