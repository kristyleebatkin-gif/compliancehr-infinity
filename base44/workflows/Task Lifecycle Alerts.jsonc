{
  "name": "Task Lifecycle Alerts",
  "description": "Notify assigned app users when tasks are assigned, rescheduled, returned or closed, and notify existing approvers when sign-off is requested.",
  "trigger": {
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; (IN(\"tenant_id\", \"updated_date\", \"created_by_id\", \"created_by\", \"is_sample\") | not))) and (.trigger.event_type == \"create\" or (.trigger.changed_fields != null and any(.trigger.changed_fields[]; . == \"status\" or . == \"assigned_email\" or . == \"responsible_emails\" or . == \"due_date\"))) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TodoTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_lifecycle_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_task_participants": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "taskWorkflowAlerts",
            "args": {
              "action": "event",
              "task_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }",
              "expected_status": "${ .trigger.data.status // \"\" }",
              "previous": {
                "status": "${ .trigger.old_data.status // \"\" }",
                "assigned_email": "${ .trigger.old_data.assigned_email // \"\" }",
                "responsible_emails": "${ .trigger.old_data.responsible_emails // [] }",
                "due_date": "${ .trigger.old_data.due_date // \"\" }"
              },
              "tenant_id": "${ .trigger.data.tenant_id // .trigger.old_data.tenant_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify task participants",
            "description": "Assignment, sign-off and outcome alerts with direct task links"
          }
        }
      }
    ]
  }
}
