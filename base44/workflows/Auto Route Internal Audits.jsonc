{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_route_internal_audits",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "route_entry": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRouteEntry",
            "args": {
              "entity": "InternalAudit",
              "record_id": "${ .trigger.entity_id }",
              "event": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "File audit finding",
            "description": "Auto-route completed internal audits and raise compliance issues for findings"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "InternalAudit"
    }
  },
  "description": "Files internal audits into the audit register and auto-creates compliance issues from findings",
  "name": "Auto Route: Internal Audits"
}