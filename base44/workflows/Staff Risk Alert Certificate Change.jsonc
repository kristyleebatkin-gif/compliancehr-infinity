{
  "name": "Staff Risk Alert Certificate Change",
  "description": "The moment a staff certificate is created or changed, scores every staff member's compliance risk and instantly notifies admins in-app for anyone whose risk score exceeds the threshold.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Certificate",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ (.trigger.event_type != \"update\" or .trigger.changed_fields == null or any(.trigger.changed_fields[]; . != \"tenant_id\" and . != \"updated_date\")) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "staff_risk_alert_certificate_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_risk_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "staffRiskThresholdAlert",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check risk thresholds",
            "description": "Alerts admins when a staff risk score exceeds the threshold"
          }
        }
      }
    ]
  }
}