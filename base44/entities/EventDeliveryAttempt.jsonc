{
  "name": "EventDeliveryAttempt",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the automation fabric service; never from the browser."
    },
    "message_id": {
      "type": "string",
      "title": "Message Record ID"
    },
    "message_ref": {
      "type": "string",
      "title": "Message Reference"
    },
    "trace_id": {
      "type": "string",
      "title": "Trace ID"
    },
    "attempt_number": {
      "type": "number",
      "title": "Attempt Number"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Completed At"
    },
    "duration_ms": {
      "type": "number",
      "title": "Duration (ms)"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome",
      "enum": [
        "Delivered",
        "Retrying",
        "Failed",
        "Dead letter",
        "Suppressed"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "red",
        "gray"
      ],
      "default": "Retrying"
    },
    "error_code": {
      "type": "string",
      "title": "Error Code"
    },
    "error_detail": {
      "type": "string",
      "title": "Failure Reason",
      "description": "Plain-language reason for the failure, with secret-looking values stripped."
    },
    "backoff_seconds": {
      "type": "number",
      "title": "Backoff (seconds)"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "title": "Next Retry"
    },
    "workflow_instance_id": {
      "type": "string",
      "title": "Workflow Run Started"
    },
    "performed_by": {
      "type": "string",
      "title": "Attempted By",
      "description": "The person who published or retried, or System for a replay."
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "message_id",
    "message_ref",
    "attempt_number",
    "outcome",
    "started_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}