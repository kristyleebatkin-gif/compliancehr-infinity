{
  "name": "DecisionOutcome",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set by the decision register service; never from the browser."
    },
    "decision_id": {
      "type": "string",
      "title": "Decision ID"
    },
    "decision_title": {
      "type": "string",
      "title": "Decision"
    },
    "metric_name": {
      "type": "string",
      "title": "Outcome Measure"
    },
    "unit": {
      "type": "string",
      "title": "Unit"
    },
    "baseline_value": {
      "type": "number",
      "title": "Baseline"
    },
    "target_value": {
      "type": "number",
      "title": "Target"
    },
    "actual_value": {
      "type": "number",
      "title": "Actual"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "measured_date": {
      "type": "string",
      "format": "date",
      "title": "Measured On"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Not started",
        "On track",
        "Off track",
        "Achieved",
        "Not achieved"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "green",
        "red"
      ],
      "default": "Not started"
    },
    "evidence_ref": {
      "type": "string",
      "title": "Evidence Reference"
    },
    "verified_by": {
      "type": "string",
      "title": "Measured By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "decision_id",
    "metric_name",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}