{
  "name": "BusinessDetails",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "trading_name": {
      "type": "string",
      "title": "Trading Name"
    },
    "abn": {
      "type": "string",
      "title": "ABN"
    },
    "acn": {
      "type": "string",
      "title": "ACN"
    },
    "ndis_provider_number": {
      "type": "string",
      "title": "NDIS Provider Registration Number"
    },
    "address_line": {
      "type": "string",
      "title": "Street Address"
    },
    "suburb": {
      "type": "string",
      "title": "Suburb"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "postcode": {
      "type": "string",
      "title": "Postcode"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "contact_person": {
      "type": "string",
      "title": "Primary Contact"
    },
    "business_goal": {
      "type": "string",
      "title": "Business Goal"
    },
    "mission": {
      "type": "string",
      "title": "Mission"
    },
    "vision": {
      "type": "string",
      "title": "Vision"
    },
    "values": {
      "type": "string",
      "title": "Values"
    },
    "bank_name": {
      "type": "string",
      "title": "Bank Name"
    },
    "bsb": {
      "type": "string",
      "title": "BSB"
    },
    "account_number": {
      "type": "string",
      "title": "Account Number"
    },
    "account_name": {
      "type": "string",
      "title": "Account Name"
    },
    "payment_terms_days": {
      "type": "number",
      "title": "Payment Terms (Days)",
      "default": 14
    },
    "payment_terms_note": {
      "type": "string",
      "title": "Payment Terms Note",
      "default": "Payment is due within 14 days of the invoice date."
    },
    "default_invoice_notes": {
      "type": "string",
      "title": "Default Invoice Notes",
      "default": "NDIS supports are GST free. Please quote the invoice number as the payment reference."
    },
    "payment_instructions": {
      "type": "string",
      "title": "Bill Payment Instructions"
    },
    "quote_terms": {
      "type": "string",
      "title": "Quote Terms and Conditions",
      "default": "This quotation is valid for 30 days from the date of issue. Prices are based on the current NDIS Pricing Schedule and may change if the schedule is updated. NDIS supports are GST free. A formal service agreement will be prepared once the quotation is accepted."
    },
    "quote_validity_days": {
      "type": "number",
      "title": "Quote Validity (Days)",
      "default": 30
    }
  },
  "required": [
    "business_name"
  ]
}