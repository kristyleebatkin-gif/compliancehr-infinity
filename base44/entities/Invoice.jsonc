{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "client_name": {
      "type": "string",
      "title": "Billed To"
    },
    "client_email": {
      "type": "string",
      "title": "Billed To Email"
    },
    "client_address": {
      "type": "string",
      "title": "Billed To Address"
    },
    "biller_type": {
      "type": "string",
      "enum": [
        "Participant",
        "Plan Manager",
        "NDIA"
      ],
      "default": "Plan Manager",
      "title": "Biller Type"
    },
    "participant_id": {
      "type": "string",
      "title": "Participant ID"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "ndis_number": {
      "type": "string",
      "title": "NDIS Number"
    },
    "participant_address": {
      "type": "string",
      "title": "Participant Address"
    },
    "line_items": {
      "type": "string",
      "title": "Line Items (JSON)"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal ($)"
    },
    "amount": {
      "type": "number",
      "title": "Total ($)"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "Issue Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Paid",
        "Overdue"
      ],
      "default": "Draft",
      "title": "Status"
    },
    "payment_terms": {
      "type": "string",
      "title": "Payment Terms"
    },
    "payment_details": {
      "type": "string",
      "title": "Payment Details"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "pdf_file_uri": {
      "type": "string",
      "title": "Saved Invoice PDF"
    },
    "pdf_file_name": {
      "type": "string",
      "title": "Saved Invoice Filename"
    },
    "pdf_generated_date": {
      "type": "string",
      "format": "date",
      "title": "PDF Generated Date"
    },
    "pdf_library_document_id": {
      "type": "string",
      "title": "Filed Invoice Document"
    }
  },
  "required": [
    "invoice_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        }
      ]
    }
  }
}