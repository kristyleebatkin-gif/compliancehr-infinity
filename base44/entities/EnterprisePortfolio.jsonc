{
  "name": "EnterprisePortfolio",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the strategy service; never from the browser."
    },
    "portfolio_key": {
      "type": "string",
      "title": "Portfolio Reference"
    },
    "name": {
      "type": "string",
      "title": "Portfolio Name"
    },
    "description": {
      "type": "string",
      "title": "What This Portfolio Covers"
    },
    "sponsor": {
      "type": "string",
      "title": "Executive Sponsor"
    },
    "strategy_alignment": {
      "type": "string",
      "title": "Strategy Alignment",
      "description": "How this portfolio serves the organisation's stated strategy, in the sponsor's own words."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Active",
        "Paused",
        "Closed",
        "Archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "blue",
        "gray"
      ],
      "default": "Draft"
    },
    "horizon": {
      "type": "string",
      "title": "Planning Horizon"
    },
    "owner_role": {
      "type": "string",
      "title": "Portfolio Owner"
    },
    "objective_target": {
      "type": "number",
      "title": "Objective Target",
      "description": "How many objectives this portfolio is expected to carry. Recorded, not invented."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "review_due": {
      "type": "string",
      "format": "date",
      "title": "Strategy Review Due"
    },
    "status_reason": {
      "type": "string",
      "title": "Why The Status Changed"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Archived At"
    },
    "author": {
      "type": "string",
      "title": "Author"
    },
    "author_id": {
      "type": "string",
      "title": "Author (user id)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "portfolio_key",
    "name",
    "sponsor",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}