{
  "name": "GoalProgressNote",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "goal_id": {
      "type": "string",
      "title": "Goal"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "participant_user_id": {
      "type": "string",
      "title": "Participant User ID"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "Progress Note",
        "Progress Report"
      ],
      "default": "Progress Note",
      "title": "Entry Type"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "recorded_by": {
      "type": "string",
      "title": "Recorded By"
    },
    "recorded_date": {
      "type": "string",
      "format": "date",
      "title": "Recorded Date"
    }
  },
  "required": [
    "goal_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "data.participant_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
