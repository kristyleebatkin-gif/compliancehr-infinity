{
  "name": "FormsLibraryDocument",
  "type": "object",
  "properties": {
    "library": {
      "type": "string",
      "enum": [
        "Employee",
        "Participant",
        "company-safe"
      ],
      "title": "Library"
    },
    "document_type": {
      "type": "string",
      "title": "Document Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "person_name": {
      "type": "string",
      "title": "Person Name"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "title": "Uploaded Date"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    }
  },
  "required": [
    "library",
    "document_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
