        "Participant",
        "company-safe"
      ],
      "title": "Library"
    },
    "document_type": {
      "type": "string",
      "title": "Document Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "person_name": {
      "type": "string",
      "title": "Person Name"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "title": "Uploaded Date"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    }
  },
