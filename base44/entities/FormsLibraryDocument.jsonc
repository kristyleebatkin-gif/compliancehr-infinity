{
  "name": "FormsLibraryDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "library": {
      "type": "string",
      "title": "Library",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Intake Officer"
              }
            }
          ]
        }
      }
    },
    "document_type": {
      "type": "string",
      "title": "Document Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "person_name": {
      "type": "string",
      "title": "Person Name"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_url": {
      "type": "string",
      "title": "Attached master file URL"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "title": "Uploaded Date"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    }
  },
  "required": [
    "library",
    "document_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Finance & Accounts Officer"
              }
            },
            {
              "data.document_type": {
                "$in": [
                  "Invoice",
                  "Quote"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_staff_library}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_participant_library}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Finance & Accounts Officer"
              }
            },
            {
              "data.document_type": {
                "$in": [
                  "Invoice",
                  "Quote"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_staff_library}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_participant_library}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_staff_library}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.library": {
                "$ne": null
              }
            },
            {
              "data.library": "{{user.data.personal_participant_library}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
