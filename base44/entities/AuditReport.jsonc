{
  "type": "object",
  "name": "AuditReport",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "audit_date": {
      "type": "string",
      "title": "Audit Date",
      "format": "date"
    },
    "readiness_score": {
      "type": "number",
      "title": "Readiness Score (%)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Generated",
        "Reviewed",
        "Finalised"
      ],
      "default": "Draft"
    },
    "findings": {
      "type": "string",
      "title": "Findings"
    },
    "participant_files_score": {
      "type": "number",
      "title": "Participant Files Score (%)"
    },
    "staff_files_score": {
      "type": "number",
      "title": "Staff Files Score (%)"
    },
    "training_score": {
      "type": "number",
      "title": "Training Score (%)"
    },
    "policies_score": {
      "type": "number",
      "title": "Policies Score (%)"
    },
    "incidents_score": {
      "type": "number",
      "title": "Incidents Score (%)"
    },
    "risk_score": {
      "type": "number",
      "title": "Risk Score (%)"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "metrics": {
      "type": "string",
      "title": "Metrics (JSON)"
    },
    "signoff_full_name": {
      "type": "string",
      "title": "Sign-off Full Name"
    },
    "signoff_date": {
      "type": "string",
      "title": "Sign-off Date",
      "format": "date"
    },
    "signature": {
      "type": "string",
      "title": "Signature"
    }
  },
  "required": [
    "audit_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
