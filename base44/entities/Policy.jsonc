{
  "name": "Policy",
  "type": "object",
  "properties": {
    "document_name": {
      "type": "string",
      "title": "Document Name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Rights & Responsibilities",
        "Privacy",
        "Complaints",
        "Incident Management",
        "Risk Management",
        "Medication",
        "Human Resources",
        "Emergency Management",
        "Governance",
        "Quality",
        "Financial"
      ],
      "default": "Governance",
      "title": "Category"
    },
    "version": {
      "type": "string",
      "title": "Version"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Review Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Under Review",
        "Expired",
        "Archived"
      ],
      "default": "Active",
      "title": "Status"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "acknowledgement_required": {
      "type": "boolean",
      "default": false,
      "title": "Staff Acknowledgement Required"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "document_name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}