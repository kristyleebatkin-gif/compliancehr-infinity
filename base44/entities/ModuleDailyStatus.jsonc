{
  "name": "ModuleDailyStatus",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "module": {
      "type": "string",
      "title": "Module"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "title": "Snapshot Date"
    },
    "total": {
      "type": "number",
      "title": "Total Records"
    },
    "breakdown_json": {
      "type": "string",
      "title": "Status Breakdown (JSON)"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "title": "Captured At"
    }
  },
  "required": [
    "module",
    "snapshot_date"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
