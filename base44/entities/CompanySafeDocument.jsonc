{
  "type": "object",
  "name": "CompanySafeDocument",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Document Title"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "document_type": {
      "type": "string",
      "title": "Form or Document Type"
    },
    "profile_type": {
      "type": "string",
      "title": "Profile Type",
      "enum": [
        "participant",
        "employee",
        "company"
      ],
      "default": "company"
    },
    "profile_id": {
      "type": "string",
      "title": "Related Profile ID"
    },
    "intake_case_id": {
      "type": "string",
      "title": "Related Intake Case"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Record Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Record ID"
    },
    "owner_name": {
      "type": "string",
      "title": "Related Person or Area"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Submitted",
        "Completed",
        "Reviewed",
        "Archived"
      ],
      "default": "Submitted"
    },
    "submitted_by": {
      "type": "string",
      "title": "Submitted By"
    },
    "submitted_date": {
      "type": "string",
      "title": "Submitted Date",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
