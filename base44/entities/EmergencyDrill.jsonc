{
  "name": "EmergencyDrill",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Drill Title"
    },
    "drill_type": {
      "type": "string",
      "enum": [
        "Fire Evacuation",
        "Lockdown",
        "Medical Emergency",
        "Natural Disaster",
        "Other"
      ],
      "default": "Fire Evacuation",
      "title": "Drill Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "attendees_count": {
      "type": "number",
      "title": "Participants"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "Completed",
        "Partial",
        "Issues Found"
      ],
      "default": "Completed",
      "title": "Outcome"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
