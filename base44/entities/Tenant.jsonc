{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "title": "Organisation ID",
      "description": "Canonical organisation identifier used for multi-tenant isolation."
    },
    "tenant_key": {
      "type": "string",
      "title": "Tenant Key",
      "description": "Stable unique identifier used for tenant routing and migration."
    },
    "legal_name": {
      "type": "string",
      "title": "Legal Name"
    },
    "trading_name": {
      "type": "string",
      "title": "Trading Name"
    },
    "abn": {
      "type": "string",
      "title": "ABN"
    },
    "ndis_provider_number": {
      "type": "string",
      "title": "NDIS Registered Provider Number"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Provisioning",
        "Active",
        "Suspended",
        "Archived"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "default": "Provisioning"
    },
    "subscription_tier": {
      "type": "string",
      "title": "Subscription Tier",
      "enum": [
        "Free",
        "Pro",
        "Guild",
        "Enterprise"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green"
      ],
      "default": "Enterprise"
    },
    "primary_domain": {
      "type": "string",
      "title": "Primary Domain"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "brand_primary_color": {
      "type": "string",
      "title": "Primary Brand Colour",
      "default": "#0A2B6D"
    },
    "brand_secondary_color": {
      "type": "string",
      "title": "Secondary Brand Colour",
      "default": "#0072FF"
    },
    "timezone": {
      "type": "string",
      "title": "Timezone",
      "default": "Australia/Brisbane"
    },
    "default_locale": {
      "type": "string",
      "title": "Default Locale",
      "default": "en-AU"
    },
    "provisioning_notes": {
      "type": "string",
      "title": "Provisioning Notes"
    }
  },
  "required": [
    "tenant_key",
    "legal_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}