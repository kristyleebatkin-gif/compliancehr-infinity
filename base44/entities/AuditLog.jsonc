{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID"
    },
    "action": {
      "type": "string",
      "title": "Action"
    },
    "entity_type": {
      "type": "string",
      "title": "Entity Type"
    },
    "record_id": {
      "type": "string",
      "title": "Record ID"
    },
    "record_title": {
      "type": "string",
      "title": "Record Title"
    },
    "performed_by": {
      "type": "string",
      "title": "Performed By"
    },
    "performed_by_user_id": {
      "type": "string",
      "title": "Performed By User ID"
    },
    "performed_by_email": {
      "type": "string",
      "title": "Performed By Email"
    },
    "performed_by_role": {
      "type": "string",
      "title": "Performed By Role"
    },
    "route": {
      "type": "string",
      "title": "App Route"
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Timestamp"
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "Audit declined",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "previous_audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "title": "Previous Audit Consent",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "change_reason": {
      "type": "string",
      "title": "Change Reason",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "participant",
        "employee"
      ],
      "enumColors": [
        "pink",
        "blue"
      ],
      "title": "Profile Type",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "person_profile_id": {
      "type": "string",
      "title": "Person Profile ID"
    },
    "person_profile_name": {
      "type": "string",
      "title": "Person Profile Name"
    },
    "person_profile_email": {
      "type": "string",
      "title": "Person Profile Email"
    }
  },
  "required": [
    "action",
    "entity_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "data.audit_consent": "Audit consent received"
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}