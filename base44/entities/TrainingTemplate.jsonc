{
  "name": "TrainingTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Template Name"
    },
    "role": {
      "type": "string",
      "enum": [
        "Support Worker",
        "Team Leader",
        "Compliance Manager",
        "Administration",
        "Management"
      ],
      "default": "Support Worker",
      "title": "Role"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "module_titles": {
      "type": "string",
      "title": "Modules (one per line)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}