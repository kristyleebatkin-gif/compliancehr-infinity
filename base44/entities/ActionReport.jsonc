{
  "name": "ActionReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "batch_key": {
      "type": "string"
    },
    "action_count": {
      "type": "number"
    },
    "first_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "csv_file_uri": {
      "type": "string"
    },
    "pdf_file_uri": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "batch_key",
    "action_count"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}