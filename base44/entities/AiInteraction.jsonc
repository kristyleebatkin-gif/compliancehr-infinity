{
  "name": "AiInteraction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "agent_name": {
      "type": "string",
      "title": "Agent / Copilot"
    },
    "module": {
      "type": "string",
      "title": "Module"
    },
    "interaction_type": {
      "type": "string",
      "title": "Review Type"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "user_email": {
      "type": "string",
      "title": "Requested By"
    },
    "question": {
      "type": "string",
      "title": "Request"
    },
    "response_summary": {
      "type": "string",
      "title": "Response Summary"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence (%)"
    },
    "source_count": {
      "type": "number",
      "title": "Records Referenced"
    },
    "duration_ms": {
      "type": "number",
      "title": "Duration (ms)"
    },
    "flagged": {
      "type": "boolean",
      "default": false,
      "title": "Flagged by Human"
    },
    "override": {
      "type": "boolean",
      "default": false,
      "title": "Human Override"
    },
    "flag_reason": {
      "type": "string",
      "title": "Flag / Override Reason"
    },
    "run_id": {
      "type": "string"
    },
    "source_snapshot": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "state": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "reviewed_interaction_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    }
  },
  "required": [
    "agent_name",
    "module",
    "response_summary"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}