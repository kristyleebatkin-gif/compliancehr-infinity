{
  "type": "object",
  "name": "AssetMaintenance",
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "format": "date"
    },
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "asset_name": {
      "type": "string",
      "title": "Asset Name"
    },
    "maintenance_required": {
      "type": "string",
      "title": "Maintenance Required"
    },
    "action_taken": {
      "type": "string",
      "title": "Action Taken"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By"
    },
    "cost": {
      "type": "number",
      "title": "Cost"
    },
    "next_maintenance_date": {
      "type": "string",
      "title": "Next Maintenance Date",
      "format": "date"
    },
