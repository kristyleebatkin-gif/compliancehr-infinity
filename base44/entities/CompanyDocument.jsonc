{
  "name": "CompanyDocument",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Document Name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Policies",
        "Templates",
        "Certificates",
        "Registrations",
        "Licences",
        "Financial",
        "Other"
      ],
      "default": "Other",
      "title": "Category"
    },
    "version": {
      "type": "string",
      "title": "Version"
    },
    "owner": {
      "type": "string",
      "title": "Document Owner"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Next Review"
    },
    "status": {
      "type": "string",
      "enum": [
        "Current",
        "Review Required",
        "Archived"
      ],
      "default": "Current",
      "title": "Status"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        }
      ]
    }
  }
}