{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "title": "Description"
    },
    "merchant": {
      "type": "string",
      "title": "Merchant / Supplier"
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number"
    },
    "amount": {
      "type": "number",
      "title": "Amount ($)"
    },
    "gst_amount": {
      "type": "number",
      "title": "GST Amount ($)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "paid_by": {
      "type": "string",
      "title": "Paid By"
    },
    "reimburse_to": {
      "type": "string",
      "title": "Reimburse To"
    },
    "reimbursed": {
      "type": "boolean",
      "default": false,
      "title": "Reimbursed"
    },
    "reimbursed_date": {
      "type": "string",
      "format": "date",
      "title": "Reimbursed Date"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method"
    },
    "ndis_category": {
      "type": "string",
      "title": "NDIS Support Category",
      "enum": [
        "Assistance with Daily Life (Core)",
        "Assistance with Social & Community Participation (Core)",
        "Consumables (Core)",
        "Transport (Core)",
        "Capacity Building - Improved Daily Living",
        "Capacity Building - Improved Health & Wellbeing",
        "Capacity Building - Finding & Keeping a Job",
        "Capacity Building - Improved Learning",
        "Capacity Building - Improved Relationships",
        "Capacity Building - Increased Social & Community Participation",
        "Capacity Building - Improved Living Arrangements",
        "Capital - Assistive Technology",
        "Capital - Home Modifications",
        "Other"
      ]
    },
    "ndis_support_item_number": {
      "type": "string",
      "title": "NDIS Support Item Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Unreconciled",
        "Reconciled"
      ],
      "default": "Unreconciled",
      "title": "Status"
    },
    "receipt_url": {
      "type": "string",
      "title": "Receipt Link"
    },
    "file_uri": {
      "type": "string",
      "title": "Receipt File URI"
    },
    "file_name": {
      "type": "string",
      "title": "Receipt File Name"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Employee"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Employee"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}