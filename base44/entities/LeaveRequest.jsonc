{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string",
      "title": "Staff Member"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "Annual",
        "Personal / Sick",
        "Carer's",
        "Unpaid",
        "Long Service",
        "Study",
        "Family & Domestic Violence",
        "Compassionate / Bereavement",
        "Community Service",
        "Parental",
        "Other"
      ],
      "default": "Annual",
      "title": "Leave Type"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "days": {
      "type": "number",
      "title": "Days"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "coverage_arranged": {
      "type": "string",
      "title": "Coverage Arranged"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Declined"
      ],
      "default": "Pending",
      "title": "Status"
    },
    "decided_by": {
      "type": "string",
      "title": "Decided By"
    },
    "decided_date": {
      "type": "string",
      "format": "date",
      "title": "Decision Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "staff_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        }
      ]
    }
  }
}