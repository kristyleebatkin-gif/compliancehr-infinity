{
  "name": "IntegrationConnector",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the automation fabric service; never from the browser."
    },
    "connector_key": {
      "type": "string",
      "title": "Connector Key"
    },
    "name": {
      "type": "string",
      "title": "Connector Name"
    },
    "kind": {
      "type": "string",
      "title": "Connector Kind",
      "enum": [
        "Webhook",
        "Message queue",
        "HTTP API",
        "Email",
        "SMS",
        "Workflow"
      ],
      "enumColors": [
        "blue",
        "purple",
        "teal",
        "green",
        "yellow",
        "gray"
      ],
      "default": "Webhook"
    },
    "endpoint_label": {
      "type": "string",
      "title": "Endpoint",
      "description": "Where messages go, described in words. A URL carrying a token is refused."
    },
    "credential_ref": {
      "type": "string",
      "title": "Credential Reference",
      "description": "The NAME of the secret the app holds, e.g. secret://SLACK_WEBHOOK_URL. The secret itself is never stored on this record or returned by the API."
    },
    "auth_scheme": {
      "type": "string",
      "title": "Authentication",
      "enum": [
        "Secret reference",
        "Connected app connector",
        "None"
      ],
      "enumColors": [
        "green",
        "blue",
        "gray"
      ],
      "default": "Secret reference"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "Disabled",
        "Unverified"
      ],
      "enumColors": [
        "green",
        "gray",
        "yellow"
      ],
      "default": "Unverified"
    },
    "rate_limit_per_minute": {
      "type": "number",
      "title": "Rate Limit (per minute)",
      "default": 60
    },
    "max_attempts": {
      "type": "number",
      "title": "Maximum Attempts",
      "default": 3
    },
    "retry_policy_json": {
      "type": "string",
      "title": "Retry Policy (JSON)",
      "description": "Base delay and ceiling for exponential backoff, recorded so a failure can be explained later."
    },
    "allowed_event_types_json": {
      "type": "string",
      "title": "Permitted Events (JSON)",
      "description": "Events this connector may carry. An event outside the list is refused rather than sent."
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Verified"
    },
    "verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "created_by_name": {
      "type": "string",
      "title": "Created By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "connector_key",
    "name",
    "kind",
    "auth_scheme",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}