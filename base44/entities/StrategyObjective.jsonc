{
  "name": "StrategyObjective",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the strategy service; never from the browser."
    },
    "objective_key": {
      "type": "string",
      "title": "Objective Reference"
    },
    "program_id": {
      "type": "string",
      "title": "Program Record ID"
    },
    "program_key": {
      "type": "string",
      "title": "Program Reference"
    },
    "program_name": {
      "type": "string",
      "title": "Program"
    },
    "portfolio_id": {
      "type": "string",
      "title": "Portfolio Record ID"
    },
    "portfolio_key": {
      "type": "string",
      "title": "Portfolio Reference"
    },
    "name": {
      "type": "string",
      "title": "Objective"
    },
    "owner": {
      "type": "string",
      "title": "Objective Owner"
    },
    "measure": {
      "type": "string",
      "title": "Measure",
      "description": "What is counted or measured to show the objective is met."
    },
    "unit": {
      "type": "string",
      "title": "Unit"
    },
    "baseline_value": {
      "type": "number",
      "title": "Baseline"
    },
    "target_value": {
      "type": "number",
      "title": "Target"
    },
    "current_value": {
      "type": "number",
      "title": "Current Measure",
      "description": "The latest actual figure. Progress is calculated from this, never estimated."
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Not started",
        "On track",
        "At risk",
        "Off track",
        "Achieved",
        "Archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "red",
        "blue",
        "gray"
      ],
      "default": "Not started"
    },
    "linked_records_json": {
      "type": "string",
      "title": "Linked Records (JSON)",
      "description": "References to decisions, risks, controls, evidence, workflows and AI recommendations. The source registers stay the only records."
    },
    "status_reason": {
      "type": "string",
      "title": "Why The Status Changed"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Archived At"
    },
    "author": {
      "type": "string",
      "title": "Author"
    },
    "author_id": {
      "type": "string",
      "title": "Author (user id)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "objective_key",
    "program_id",
    "name",
    "owner",
    "measure",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}