{
  "name": "IntakeCase",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "title": "Intake Case Number"
    },
    "intake_type": {
      "type": "string",
      "enum": [
        "Participant",
        "Employee"
      ],
      "title": "Intake Type"
    },
    "applicant_name": {
      "type": "string",
      "title": "Applicant Name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "ndis_number": {
      "type": "string",
      "title": "NDIS Number"
    },
    "ndis_reference_number": {
      "type": "string",
      "title": "NDIS Reference Number"
    },
    "preferred_name_pronouns": {
      "type": "string",
      "title": "Preferred Name and Pronouns"
    },
    "primary_contact": {
      "type": "string",
      "title": "Primary Contact / Nominee"
    },
    "communication_needs": {
      "type": "string",
      "title": "Communication and Accessibility Needs"
    },
    "requested_supports": {
      "type": "string",
      "title": "Requested Supports"
    },
    "reason_for_referral": {
      "type": "string",
      "title": "Reason for Referral / Application"
    },
    "current_supports": {
      "type": "string",
      "title": "Current Supports and Living Arrangements"
    },
    "goals_preferences": {
      "type": "string",
      "title": "Strengths, Preferences and Goals"
    },
    "health_summary": {
      "type": "string",
      "title": "Health, Medication and Allergy Information"
    },
    "risk_summary": {
      "type": "string",
      "title": "Risks and Immediate Safeguards"
    },
    "emergency_contact": {
      "type": "string",
      "title": "Emergency Contact"
    },
    "emergency_contact_1_name": {
      "type": "string",
      "title": "Emergency Contact 1 Name"
    },
    "emergency_contact_1_relationship": {
      "type": "string",
      "title": "Emergency Contact 1 Relationship"
    },
    "emergency_contact_1_phone": {
      "type": "string",
      "title": "Emergency Contact 1 Phone"
    },
    "emergency_contact_2_name": {
      "type": "string",
      "title": "Emergency Contact 2 Name"
    },
    "emergency_contact_2_relationship": {
      "type": "string",
      "title": "Emergency Contact 2 Relationship"
    },
    "emergency_contact_2_phone": {
      "type": "string",
      "title": "Emergency Contact 2 Phone"
    },
    "representative_details": {
      "type": "string",
      "title": "Representative / Advocate Details"
    },
    "gender": {
      "type": "string",
      "title": "Gender"
    },
    "language_spoken": {
      "type": "string",
      "title": "Language Spoken"
    },
    "interpreter_required": {
      "type": "boolean",
      "default": false,
      "title": "Interpreter Required"
    },
    "cultural_background": {
      "type": "string",
      "title": "Cultural Background"
    },
    "guardian_name": {
      "type": "string",
      "title": "Guardian / Nominee Name"
    },
    "guardian_contact": {
      "type": "string",
      "title": "Guardian / Nominee Contact"
    },
    "guardian_consent": {
      "type": "boolean",
      "default": false,
      "title": "Guardian Consent Obtained"
    },
    "gp_name": {
      "type": "string",
      "title": "GP Name"
    },
    "gp_contact": {
      "type": "string",
      "title": "GP Contact"
    },
    "funding_categories": {
      "type": "string",
      "title": "NDIS Funding Categories"
    },
    "transport_needs": {
      "type": "string",
      "title": "Transport Needs"
    },
    "ndis_plan_goals": {
      "type": "string",
      "title": "NDIS Plan Goals"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "Plan Managed",
        "Self Managed",
        "NDIA Managed"
      ],
      "title": "Plan Type"
    },
    "plan_start_date": {
      "type": "string",
      "format": "date",
      "title": "NDIS Plan Start Date"
    },
    "plan_end_date": {
      "type": "string",
      "format": "date",
      "title": "NDIS Plan End Date"
    },
    "plan_manager": {
      "type": "string",
      "title": "Plan Manager"
    },
    "support_coordinator": {
      "type": "string",
      "title": "Support Coordinator"
    },
    "medication_support_required": {
      "type": "boolean",
      "default": false,
      "title": "Medication Support Required"
    },
    "mealtime_support_required": {
      "type": "boolean",
      "default": false,
      "title": "Mealtime Support Required"
    },
    "behaviour_support_required": {
      "type": "boolean",
      "default": false,
      "title": "Behaviour Support Required"
    },
    "restrictive_practice_identified": {
      "type": "boolean",
      "default": false,
      "title": "Restrictive Practice Identified"
    },
    "current_employment_status": {
      "type": "string",
      "title": "Current Employment Status"
    },
    "years_experience": {
      "type": "number",
      "title": "Years of Experience"
    },
    "right_to_work": {
      "type": "boolean",
      "default": false,
      "title": "Right to Work in Australia"
    },
    "drivers_licence": {
      "type": "boolean",
      "default": false,
      "title": "Current Driver Licence"
    },
    "own_vehicle": {
      "type": "boolean",
      "default": false,
      "title": "Own Vehicle"
    },
    "wwcc_number": {
      "type": "string",
      "title": "Working With Children Check Number"
    },
    "ndis_worker_screening_number": {
      "type": "string",
      "title": "NDIS Worker Screening Check Number"
    },
    "first_aid_current": {
      "type": "boolean",
      "default": false,
      "title": "First Aid Certificate Current"
    },
    "previous_employer": {
      "type": "string",
      "title": "Previous Employer"
    },
    "referees": {
      "type": "string",
      "title": "Referees"
    },
    "availability": {
      "type": "string",
      "title": "Availability"
    },
    "why_apply": {
      "type": "string",
      "title": "Why Do You Want This Role"
    },
    "workplace_adjustments": {
      "type": "string",
      "title": "Medical Alerts, Allergies or Workplace Adjustments"
    },
    "employee_role": {
      "type": "string",
      "title": "Employee Role"
    },
    "position": {
      "type": "string",
      "title": "Position"
    },
    "referral_source": {
      "type": "string",
      "title": "Referral Source"
    },
    "referral_date": {
      "type": "string",
      "format": "date",
      "title": "Referral / Application Date"
    },
    "target_start_date": {
      "type": "string",
      "format": "date",
      "title": "Target Start Date"
    },
    "assigned_to": {
      "type": "string",
      "title": "Intake Owner"
    },
    "reviewer": {
      "type": "string",
      "title": "Reviewer"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "title": "Reviewed Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Information Required",
        "Ready for Review",
        "Approved",
        "Converted to Profile",
        "Declined",
        "Withdrawn"
      ],
      "default": "Draft",
      "title": "Status"
    },
    "service_fit": {
      "type": "string",
      "enum": [
        "Pending",
        "Eligible",
        "Waitlist",
        "Not Suitable"
      ],
      "default": "Pending",
      "title": "Eligibility / Service Fit"
    },
    "privacy_consent": {
      "type": "boolean",
      "default": false,
      "title": "Consent to Collect and Store Intake Information"
    },
    "recognition_dashboard_consent": {
      "type": "boolean",
      "default": false,
      "title": "Consent to Appear on Employee Recognition Dashboard"
    },
    "recognition_dashboard_consent_date": {
      "type": "string",
      "format": "date",
      "title": "Recognition Dashboard Consent Date"
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "title": "Consent to NDIS Audit"
    },
    "audit_consent_by": {
      "type": "string",
      "title": "Audit Consent Given By (person)"
    },
    "audit_consent_date": {
      "type": "string",
      "title": "Audit Consent Date"
    },
    "audit_consent_time": {
      "type": "string",
      "title": "Audit Consent Time"
    },
    "audit_consent_note": {
      "type": "string",
      "title": "Audit Consent Note (who consented / declined)"
    },
    "completed_document_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Completed or Uploaded Documents"
    },
    "outstanding_actions": {
      "type": "string",
      "title": "Outstanding Actions"
    },
    "decision_reason": {
      "type": "string",
      "title": "Decision Reason"
    },
    "related_profile_id": {
      "type": "string",
      "title": "Related Profile ID"
    },
    "converted_date": {
      "type": "string",
      "format": "date",
      "title": "Converted Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "applicant_name"
  ]
}