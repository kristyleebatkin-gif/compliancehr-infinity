{
  "type": "object",
  "name": "ParticipantReview",
  "properties": {
    "participant_id": {
      "type": "string",
      "title": "Participant"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant Name"
    },
    "review_date": {
      "type": "string",
      "title": "Review Date",
      "format": "date"
    },
    "review_type": {
      "type": "string",
      "title": "Review Type",
      "enum": [
        "Initial",
        "3 Monthly",
        "6 Monthly",
        "9 Monthly",
        "12 Monthly",
        "Scheduled",
        "Annual",
        "Interim",
        "Exit"
      ],
      "default": "Scheduled"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Overdue"
      ],
      "default": "Scheduled"
    },
    "reviewer": {
      "type": "string",
      "title": "Reviewer"
    },
    "next_review_due": {
      "type": "string",
      "title": "Next Review Due",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "audit_consent": {
      "type": "string",
      "title": "Audit Consent",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    }
  },
  "required": [
    "participant_id",
    "review_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Participant"
              }
            },
            {
              "data.participant_name": "{{user.full_name}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "data.audit_consent": "Audit consent received"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}