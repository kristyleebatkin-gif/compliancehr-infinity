{
  "name": "EnterpriseCapability",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the strategy service; never from the browser."
    },
    "capability_key": {
      "type": "string",
      "title": "Capability Reference"
    },
    "name": {
      "type": "string",
      "title": "Capability Name"
    },
    "domain": {
      "type": "string",
      "title": "Domain"
    },
    "owner": {
      "type": "string",
      "title": "Capability Owner"
    },
    "current_maturity": {
      "type": "number",
      "title": "Current Maturity (1-5)",
      "description": "What the organisation records today. A validated maturity assessment overrides this figure."
    },
    "target_maturity": {
      "type": "number",
      "title": "Target Maturity (1-5)"
    },
    "evidence_basis": {
      "type": "string",
      "title": "Evidence Basis",
      "description": "What the recorded maturity rests on, in the owner's own words."
    },
    "control_refs_json": {
      "type": "string",
      "title": "Linked Controls (JSON)",
      "description": "References to compliance controls and evidence. Those registers keep the records."
    },
    "latest_assessment_id": {
      "type": "string",
      "title": "Latest Assessment Record ID"
    },
    "latest_assessment_score": {
      "type": "number",
      "title": "Latest Validated Score"
    },
    "latest_assessment_at": {
      "type": "string",
      "format": "date-time",
      "title": "Latest Assessment Date"
    },
    "evidence_backed": {
      "type": "boolean",
      "title": "Evidence Backed",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Active",
        "Archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "gray"
      ],
      "default": "Draft"
    },
    "review_due": {
      "type": "string",
      "format": "date",
      "title": "Maturity Review Due"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Archived At"
    },
    "author": {
      "type": "string",
      "title": "Author"
    },
    "author_id": {
      "type": "string",
      "title": "Author (user id)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "capability_key",
    "name",
    "owner",
    "current_maturity",
    "target_maturity",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}