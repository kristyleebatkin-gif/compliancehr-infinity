{
  "name": "AiModel",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "approved_uses": {
      "type": "string"
    },
    "retention_terms": {
      "type": "string"
    },
    "evaluation_ref": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "provider",
    "version"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__server_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
