// Backlog 17.07: an invitation records which business asked someone to join, so their first sign-in
// can be approved and linked to that business. Read and written only by the manageAppAccess function.
{
  "name": "AccountInvitation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "role": {
      "type": "string",
      "title": "Role on approval"
    },
    "invited_by_id": {
      "type": "string",
      "title": "Invited by (user id)"
    },
    "invited_by_name": {
      "type": "string",
      "title": "Invited by"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Accepted",
        "Cancelled",
        "Declined"
      ],
      "default": "Pending",
      "title": "Status"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "title": "Decided at"
    },
    "decided_by_name": {
      "type": "string",
      "title": "Decided by"
    },
    "user_id": {
      "type": "string",
      "title": "Account (user id) once approved"
    }
  },
  "required": [
    "email",
    "role",
    "invited_by_id",
    "expires_at",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
