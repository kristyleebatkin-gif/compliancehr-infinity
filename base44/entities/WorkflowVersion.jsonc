{
  "name": "WorkflowVersion",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "definition_id": {
      "type": "string",
      "title": "Definition ID"
    },
    "definition_code": {
      "type": "string",
      "title": "Workflow Code"
    },
    "definition_name": {
      "type": "string",
      "title": "Workflow Name"
    },
    "version": {
      "type": "number",
      "title": "Version"
    },
    "content_hash": {
      "type": "string",
      "title": "Graph Hash",
      "description": "Hash of the exact published graph. A published version is never edited."
    },
    "nodes_json": {
      "type": "string",
      "title": "Graph Snapshot"
    },
    "validation_json": {
      "type": "string",
      "title": "Validation Report"
    },
    "publisher_independent": {
      "type": "boolean",
      "default": false,
      "title": "Independent Publisher"
    },
    "publication_note": {
      "type": "string",
      "title": "Publication Note"
    },
    "published_by": {
      "type": "string",
      "title": "Published By"
    },
    "published_by_id": {
      "type": "string",
      "title": "Published By (user id)"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "title": "Published At"
    }
  },
  "required": [
    "tenant_id",
    "definition_id",
    "version",
    "content_hash"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}