{
  "name": "WorkspacePreferenceVersion",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID"
    },
    "preference_id": {
      "type": "string",
      "title": "Layout Record ID",
      "description": "The WorkspacePreference row this snapshot belongs to."
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "workspace_key": {
      "type": "string",
      "title": "Workspace"
    },
    "version_number": {
      "type": "number",
      "title": "Version",
      "description": "Append-only. A saved snapshot is never edited."
    },
    "layout_json": {
      "type": "string",
      "title": "Layout Snapshot"
    },
    "content_hash": {
      "type": "string",
      "title": "Layout Hash"
    },
    "schema_version": {
      "type": "number",
      "title": "Layout Schema Version",
      "default": 1
    },
    "saved_by": {
      "type": "string",
      "title": "Saved By"
    },
    "saved_by_id": {
      "type": "string",
      "title": "Saved By (user id)"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Saved At"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "restored_from_version": {
      "type": "number",
      "title": "Restored From Version"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "workspace_key",
    "version_number",
    "layout_json"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}