{
  "name": "AiRecommendation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Recommendation Title"
    },
    "module": {
      "type": "string",
      "title": "Module"
    },
    "agent_name": {
      "type": "string",
      "title": "Raised By"
    },
    "recommendation_type": {
      "type": "string",
      "title": "Review Type"
    },
    "recommendation": {
      "type": "string",
      "title": "Recommendation"
    },
    "reasoning": {
      "type": "string",
      "title": "Reasoning"
    },
    "executive_summary": {
      "type": "string",
      "title": "Executive Summary"
    },
    "confidence": {
      "type": "number",
      "title": "Confidence (%)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "red",
        "red"
      ],
      "default": "Medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "Awaiting review",
        "Accepted",
        "Rejected",
        "Implemented"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "blue"
      ],
      "default": "Awaiting review",
      "title": "Status"
    },
    "standard_refs": {
      "type": "string",
      "title": "Standards Impacted"
    },
    "control_refs": {
      "type": "string",
      "title": "Controls Impacted"
    },
    "risk_refs": {
      "type": "string",
      "title": "Risks Impacted"
    },
    "evidence_refs": {
      "type": "string",
      "title": "Evidence Referenced"
    },
    "traceability": {
      "type": "string",
      "title": "Traceability Map"
    },
    "human_verified_by": {
      "type": "string",
      "title": "Verified By"
    },
    "human_verified_date": {
      "type": "string",
      "format": "date",
      "title": "Verified Date"
    },
    "override_reason": {
      "type": "string",
      "title": "Override / Rejection Reason"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "interaction_id": {
      "type": "string"
    },
    "source_snapshot": {
      "type": "object"
    },
    "associated_audits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "recommendation"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}