{
  "name": "Risk",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Risk Title"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "Risk",
        "Hazard",
        "Near Miss"
      ],
      "default": "Risk",
      "title": "Report Type"
    },
    "risk_id": {
      "type": "string",
      "title": "Risk ID"
    },
    "participant_id": {
      "type": "string",
      "title": "Related Participant"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Operational",
        "Clinical",
        "Financial",
        "Workplace Health & Safety",
        "Participant",
        "Compliance"
      ],
      "default": "Operational",
      "title": "Category"
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "Rare",
        "Unlikely",
        "Possible",
        "Likely",
        "Almost Certain"
      ],
      "default": "Possible",
      "title": "Likelihood"
    },
    "consequence": {
      "type": "string",
      "enum": [
        "Insignificant",
        "Minor",
        "Moderate",
        "Major",
        "Severe"
      ],
      "default": "Moderate",
      "title": "Consequence"
    },
    "rating": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "default": "Medium",
      "title": "Risk Rating"
    },
    "status": {
      "type": "string",
      "enum": [
        "Identified",
        "Assessed",
        "Treating",
        "Monitored",
        "Closed"
      ],
      "default": "Identified",
      "title": "Status"
    },
    "owner": {
      "type": "string",
      "title": "Risk Owner"
    },
    "mitigation_plan": {
      "type": "string",
      "title": "Mitigation Plan"
    },
    "hazards_identified": {
      "type": "string",
      "title": "Risks / Hazards Identified"
    },
    "risk_assessment": {
      "type": "string",
      "title": "Risk Assessment"
    },
    "control_measures": {
      "type": "string",
      "title": "Control Measures"
    },
    "control_measure_category": {
      "type": "string",
      "enum": [
        "Preventative",
        "Protective",
        "Training & Capability",
        "Policy & Procedure",
        "Environmental",
        "Equipment & Technology",
        "Supervision & Monitoring",
        "Emergency Response",
        "Administrative"
      ],
      "default": "Preventative",
      "title": "Control Measure Category"
    },
    "elimination_actions": {
      "type": "string",
      "title": "Elimination Actions"
    },
    "minimise_actions": {
      "type": "string",
      "title": "Minimise Actions"
    },
    "isolate_actions": {
      "type": "string",
      "title": "Isolate Actions"
    },
    "staff_training_controls": {
      "type": "string",
      "title": "Staff Training Controls"
    },
    "compliance_controls": {
      "type": "string",
      "title": "Compliance Controls"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Review Date"
    },
    "identified_date": {
      "type": "string",
      "format": "date",
      "title": "Date Identified"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "Not scheduled",
        "Individual",
        "Home"
      ],
      "default": "Not scheduled",
      "title": "Assessment Schedule"
    },
    "last_assessed_date": {
      "type": "string",
      "format": "date",
      "title": "Last Assessed Date"
    },
    "next_due_date": {
      "type": "string",
      "format": "date",
      "title": "Next Assessment Due"
    },
    "action_log": {
      "type": "string",
      "title": "Assessment Action Log"
    },
    "source_entity_type": {
      "type": "string",
      "title": "Source Entity Type"
    },
    "source_entity_id": {
      "type": "string",
      "title": "Source Record ID"
    },
    "source_item_key": {
      "type": "string",
      "title": "Source Item Key"
    },
    "source_document_url": {
      "type": "string",
      "title": "Source Document URL"
    },
    "source_form_title": {
      "type": "string",
      "title": "Source Form Title"
    },
    "source_answers_json": {
      "type": "string",
      "title": "Source Answers JSON"
    },
    "intake_case_id": {
      "type": "string",
      "title": "Related Intake Case"
    }
  },
  "required": [
    "title",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        },
        {
          "user_condition": {
            "role": "Employee"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}