{
  "name": "StaffProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "position": {
      "type": "string",
      "title": "Position"
    },
    "position_level": {
      "type": "string",
      "title": "Position Level"
    },
    "role": {
      "type": "string",
      "enum": [
        "Support Worker",
        "Team Leader",
        "Compliance Manager",
        "Administration",
        "Management"
      ],
      "default": "Support Worker",
      "title": "Role"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Leave",
        "Inactive"
      ],
      "default": "Active",
      "title": "Status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "induction_date": {
      "type": "string",
      "format": "date",
      "title": "Induction Date"
    },
    "employee_number": {
      "type": "string",
      "title": "Employee Number"
    },
    "supervisor": {
      "type": "string",
      "title": "Supervisor"
    },
    "emergency_contact": {
      "type": "string",
      "title": "Emergency Contact"
    },
    "emergency_contact_phone": {
      "type": "string",
      "title": "Emergency Contact Phone"
    },
    "banking_details": {
      "type": "string",
      "title": "Banking Details"
    },
    "superannuation_details": {
      "type": "string",
      "title": "Superannuation Details"
    },
    "hourly_rate": {
      "type": "number",
      "title": "Hourly Rate ($)"
    },
    "tax_file_number": {
      "type": "string",
      "title": "Tax File Number"
    },
    "car_rego": {
      "type": "string",
      "title": "Car Registration (Rego)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "full_name"
  ]
}