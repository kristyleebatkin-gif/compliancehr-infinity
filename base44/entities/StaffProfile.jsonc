{
  "name": "StaffProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "position": {
      "type": "string",
      "title": "Position"
    },
    "position_level": {
      "type": "string",
      "title": "Position Level"
    },
    "role": {
      "type": "string",
      "enum": [
        "Support Worker",
        "Team Leader",
        "Compliance Manager",
        "Administration",
        "Management"
      ],
      "default": "Support Worker",
      "title": "Role"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Leave",
        "Inactive"
      ],
      "default": "Active",
      "title": "Status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "exit_reason": {
      "type": "string",
      "title": "Exit Reason"
    },
    "induction_date": {
      "type": "string",
      "format": "date",
      "title": "Induction Date"
    },
    "employee_number": {
      "type": "string",
      "title": "Employee Number"
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "admin",
        "Provider Administrator",
        "Compliance Manager",
        "Administration",
        "Support Worker",
        "Participant",
        "Auditor"
      ],
      "default": "user",
      "title": "App Role (Permissions)"
    },
    "profile_photo_uri": {
      "type": "string",
      "title": "Profile Photo (File URI)"
    },
    "about_me": {
      "type": "string",
      "title": "About Me"
    },
    "change_log": {
      "type": "string",
      "title": "Details Check & Change Log"
    },
    "last_details_check_date": {
      "type": "string",
      "format": "date",
      "title": "Last Details Check Requested"
    },
    "supervisor": {
      "type": "string",
      "title": "Supervisor"
    },
    "emergency_contact": {
      "type": "string",
      "title": "Emergency Contact"
    },
    "emergency_contact_phone": {
      "type": "string",
      "title": "Emergency Contact Phone"
    },
    "banking_details": {
      "type": "string",
      "title": "Banking Details"
    },
    "superannuation_details": {
      "type": "string",
      "title": "Superannuation Details"
    },
    "hourly_rate": {
      "type": "number",
      "title": "Hourly Rate ($)"
    },
    "tax_file_number": {
      "type": "string",
      "title": "Tax File Number"
    },
    "car_rego": {
      "type": "string",
      "title": "Car Registration (Rego)"
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "title": "Audit Consent"
    },
    "audit_consent_recorded_by": {
      "type": "string",
      "title": "Audit Consent Recorded By"
    },
    "audit_consent_recorded_date": {
      "type": "string",
      "title": "Audit Consent Recorded Date"
    },
    "audit_consent_recorded_time": {
      "type": "string",
      "title": "Audit Consent Recorded Time"
    },
    "consents_received": {
      "type": "string",
      "title": "Consents Received (Log)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "full_name"
  ]
}