{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "Compliance Review",
        "Governance / Board",
        "Staff Meeting",
        "Participant Planning",
        "Quality & Improvement",
        "Incident / Risk Review",
        "Other"
      ],
      "default": "Staff Meeting",
      "title": "Meeting Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Start Time"
    },
    "duration": {
      "type": "string",
      "title": "Expected Duration"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "meeting_link": {
      "type": "string",
      "title": "Video / Meeting Link"
    },
    "chair": {
      "type": "string",
      "title": "Chairperson"
    },
    "minute_taker": {
      "type": "string",
      "title": "Minute Taker"
    },
    "attendees": {
      "type": "string",
      "title": "Attendees"
    },
    "attendee_emails": {
      "type": "string",
      "title": "Attendee Emails (comma-separated)"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "agenda": {
      "type": "string",
      "title": "Agenda"
    },
    "attendance": {
      "type": "string",
      "title": "Attendance (attended / apologies)"
    },
    "minutes": {
      "type": "string",
      "title": "Minutes / Decisions"
    },
    "assessment": {
      "type": "string",
      "title": "Meeting Assessment (what worked / improvements)"
    },
    "minutes_file_uri": {
      "type": "string",
      "title": "Completed Minutes File URI"
    },
    "minutes_file_name": {
      "type": "string",
      "title": "Completed Minutes File Name"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "title": "Invites Sent At"
    },
    "invited_to": {
      "type": "string",
      "title": "Invites Sent To"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Completed",
        "Cancelled"
      ],
      "default": "Scheduled",
      "title": "Status"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}