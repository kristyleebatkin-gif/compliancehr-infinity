{
  "type": "object",
  "name": "InvoiceTemplateSettings",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "provider_id": {
      "type": "string",
      "title": "Provider"
    },
    "invoice_prefix": {
      "type": "string",
      "title": "Invoice Prefix",
      "default": "INV"
    },
    "next_invoice_number": {
      "type": "number",
      "title": "Next Invoice Number",
      "default": 1
    },
    "default_due_days": {
      "type": "number",
      "title": "Default Due Days",
      "default": 14
    },
    "payment_details": {
      "type": "string",
      "title": "Payment Details"
    },
    "payment_terms": {
      "type": "string",
      "title": "Payment Terms"
    },
    "invoice_notes": {
      "type": "string",
      "title": "Invoice Notes"
    },
    "key_contacts": {
      "type": "string",
      "title": "Key Contacts"
    },
    "xero_account_code": {
      "type": "string",
      "title": "Xero Account Code",
      "default": "200"
    },
    "xero_tax_type": {
      "type": "string",
      "title": "Xero Tax Type",
      "default": "GST Free Income"
    },
    "kms_support_item_number": {
      "type": "string",
      "title": "KMS Support Item Number"
    },
    "kms_rate": {
      "type": "number",
      "title": "Default KMS Rate",
      "default": 0
    },
    "default_remoteness": {
      "type": "string",
      "title": "Default Price Region",
      "enum": [
        "National",
        "Remote",
        "Very Remote"
      ],
      "default": "National"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "updated_by": {
      "type": "string",
      "title": "Updated By"
    },
    "updated_at": {
      "type": "string",
      "title": "Updated At",
      "format": "date-time"
    }
  },
  "required": [
    "invoice_prefix"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
