{
  "name": "WorkspaceSecurityPin",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "enum": [
        "today",
        "team-leader"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "title": "Protected Workspace"
    },
    "pin_salt": {
      "type": "string",
      "title": "PIN Salt"
    },
    "pin_hash": {
      "type": "string",
      "title": "PIN Hash (PBKDF2, server only)"
    },
    "failed_attempts": {
      "type": "number",
      "default": 0,
      "title": "Failed Unlock Attempts"
    },
    "locked_until": {
      "type": "string",
      "format": "date-time",
      "title": "Locked Until"
    },
    "last_changed_at": {
      "type": "string",
      "format": "date-time",
      "title": "PIN Last Changed"
    },
    "owner_user_id": {
      "type": "string",
      "title": "PIN Owner (user id)"
    },
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "unlocked_until": {
      "type": "string",
      "format": "date-time",
      "title": "Unlocked Until (idle timeout)"
    },
    "reset_code_hash": {
      "type": "string",
      "title": "Reset Code Hash"
    },
    "reset_code_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reset Code Expires"
    },
    "reset_code_attempts": {
      "type": "number",
      "default": 0,
      "title": "Reset Code Attempts"
    },
    "reset_code_sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reset Code Sent"
    }
  },
  "required": [
    "workspace",
    "pin_salt",
    "pin_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
