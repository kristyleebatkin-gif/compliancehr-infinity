    },
    "name": {
      "type": "string",
      "title": "Public Holiday Name"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "default": "Queensland"
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
