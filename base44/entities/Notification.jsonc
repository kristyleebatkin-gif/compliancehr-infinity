{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "Review Reminder",
        "Training Expiry",
        "Policy Review",
        "Incident Escalation",
        "Task Assigned",
        "Weekly Compliance Summary",
        "Expiry Alert",
        "Overdue Escalation",
        "General",
        "Birthday Shout-out",
        "NDIS Audit Due"
      ],
      "enumColors": [
        "yellow",
        "yellow",
        "blue",
        "red",
        "blue",
        "purple",
        "red",
        "red",
        "gray",
        "pink",
        "yellow"
      ],
      "default": "General",
      "title": "Type"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Info",
        "Warning",
        "Critical"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "red"
      ],
      "default": "Info",
      "title": "Severity"
    },
    "recipient": {
      "type": "string",
      "title": "Recipient"
    },
    "recipient_id": {
      "type": "string",
      "title": "Recipient ID"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "title": "Read"
    },
    "linked_entity_type": {
      "type": "string",
      "title": "Linked Entity Type"
    },
    "linked_entity_id": {
      "type": "string",
      "title": "Linked Entity ID"
    },
    "action_url": {
      "type": "string",
      "title": "Action URL"
    },
    "branding_company_name": {
      "type": "string",
      "title": "Branding Company Name"
    },
    "branding_logo_url": {
      "type": "string",
      "title": "Branding Logo URL"
    },
    "branding_slogan": {
      "type": "string",
      "title": "Branding Slogan"
    }
  },
  "required": [
    "type",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.recipient_id": "{{user.id}}"
            },
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$and": [
            {
              "data.recipient_id": "{{user.id}}"
            },
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$and": [
            {
              "data.recipient_id": "{{user.id}}"
            },
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            }
          ]
        }
      ]
    }
  }
}