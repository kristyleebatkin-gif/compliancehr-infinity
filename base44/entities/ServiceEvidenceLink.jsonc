{
  "name": "ServiceEvidenceLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant Id"
    },
    "shift_id": {
      "type": "string",
      "title": "Shift Id"
    },
    "note_entity": {
      "type": "string",
      "title": "Note Entity",
      "enum": [
        "ShiftNote",
        "CommunicationEntry",
        ""
      ]
    },
    "note_id": {
      "type": "string",
      "title": "Note Id"
    },
    "participant_id": {
      "type": "string",
      "title": "Participant Id"
    },
    "worker_id": {
      "type": "string",
      "title": "Worker Id"
    },
    "shift_hash": {
      "type": "string",
      "title": "Shift Hash"
    },
    "note_hash": {
      "type": "string",
      "title": "Note Hash"
    },
    "actor_id": {
      "type": "string",
      "title": "Actor Id"
    },
    "actor_role": {
      "type": "string",
      "title": "Actor Role"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "recorded_at": {
      "type": "string",
      "title": "Recorded At"
    },
    "command_key": {
      "type": "string",
      "title": "Command Key"
    },
    "action": {
      "type": "string",
      "enum": [
        "Link",
        "Unlink"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "title": "Association action"
    }
  },
  "required": [
    "tenant_id",
    "shift_id",
    "action",
    "actor_id",
    "recorded_at",
    "command_key"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Team Leader",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Management",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Rostering Coordinator",
                    "account_status": "Active",
                    "access_approved": true
                  }
                },
                {
                  "user_condition": {
                    "role": "Finance & Accounts Officer",
                    "account_status": "Active",
                    "access_approved": true
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
