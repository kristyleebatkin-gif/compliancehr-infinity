{
  "name": "TodoTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Task / Subject"
    },
    "module": {
      "type": "string",
      "title": "Module (Location)"
    },
    "task_date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "task_time": {
      "type": "string",
      "title": "Time"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "responsible": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Responsible (Staff)"
    },
    "responsible_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Responsible Emails"
    },
    "how_to_complete": {
      "type": "string",
      "title": "How to Complete"
    },
    "resources_needed": {
      "type": "string",
      "title": "Resources Needed"
    },
    "important_info": {
      "type": "string",
      "title": "Important Info"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Pending Approval",
        "Finalised"
      ],
      "default": "Pending",
      "title": "Status"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By"
    },
    "time_taken_minutes": {
      "type": "number",
      "title": "Time Taken (min)"
    },
    "signed_off_by": {
      "type": "string",
      "title": "Signed Off By"
    },
    "signed_off_date": {
      "type": "string",
      "format": "date",
      "title": "Signed Off Date"
    },
    "signature": {
      "type": "string",
      "title": "Digital Signature"
    },
    "shared_by": {
      "type": "string",
      "title": "Shared By"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}