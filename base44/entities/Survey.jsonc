{
  "name": "Survey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "Satisfaction",
        "Feedback",
        "Census",
        "Other"
      ],
      "default": "Satisfaction",
      "title": "Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "questions": {
      "type": "string",
      "title": "Questions (one per line)"
    },
    "open_date": {
      "type": "string",
      "format": "date",
      "title": "Opens"
    },
    "close_date": {
      "type": "string",
      "format": "date",
      "title": "Closes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Open",
        "Closed"
      ],
      "default": "Draft",
      "title": "Status"
    },
    "responses": {
      "type": "number",
      "title": "Responses"
    },
    "avg_rating": {
      "type": "number",
      "title": "Average Rating"
    },
    "survey_file_uri": {
      "type": "string",
      "title": "Survey Form File URI"
    },
    "survey_file_name": {
      "type": "string",
      "title": "Survey Form File Name"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}