{
  "type": "object",
  "name": "StaffMedicalProfile",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "staff_profile_id": {
      "type": "string",
      "title": "Staff Profile ID"
    },
    "emergency_contact_1_name": {
      "type": "string",
      "title": "Emergency Contact 1 Name"
    },
    "emergency_contact_1_relationship": {
      "type": "string",
      "title": "Emergency Contact 1 Relationship"
    },
    "emergency_contact_1_phone": {
      "type": "string",
      "title": "Emergency Contact 1 Phone"
    },
    "emergency_contact_2_name": {
      "type": "string",
      "title": "Emergency Contact 2 Name"
    },
    "emergency_contact_2_relationship": {
      "type": "string",
      "title": "Emergency Contact 2 Relationship"
    },
    "emergency_contact_2_phone": {
      "type": "string",
      "title": "Emergency Contact 2 Phone"
    },
    "diagnoses_medical_conditions": {
      "type": "string",
      "title": "Diagnoses / Medical Conditions"
    },
    "allergies": {
      "type": "string",
      "title": "Allergies"
    },
    "medical_alerts": {
      "type": "string",
      "title": "Medical Alerts"
    },
    "current_medications": {
      "type": "string",
      "title": "Current Medications"
    },
    "medicare_card_number": {
      "type": "string",
      "title": "Medicare Card Number"
    },
    "medicare_irn": {
      "type": "string",
      "title": "Medicare Individual Reference Number"
    },
    "medicare_expiry": {
      "type": "string",
      "title": "Medicare Expiry"
    },
    "doctor_name": {
      "type": "string",
      "title": "Doctor Name"
    },
    "doctor_phone": {
      "type": "string",
      "title": "Doctor Phone"
    },
    "doctor_email": {
      "type": "string",
      "title": "Doctor Email"
    },
    "doctor_address": {
      "type": "string",
      "title": "Doctor Address"
    },
    "specialist_name": {
      "type": "string",
      "title": "Specialist Name"
    },
    "specialist_phone": {
      "type": "string",
      "title": "Specialist Phone"
    },
    "specialist_email": {
      "type": "string",
      "title": "Specialist Email"
    },
    "specialist_address": {
      "type": "string",
      "title": "Specialist Address"
    },
    "audit_consent": {
      "type": "string",
      "title": "Audit Consent",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    }
  },
  "required": [
    "staff_profile_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                },
                {
                  "data.audit_consent": "Audit consent received"
                }
              ]
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
