{
  "type": "object",
  "name": "HRDocumentTemplate",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID — \"shared\" for master templates",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "template_type": {
      "type": "string",
      "title": "Template Type",
      "enum": [
        "Performance Appraisal",
        "Employment Contract",
        "Position Description"
      ]
    },
    "title": {
      "type": "string",
      "title": "Template Title"
    },
    "content": {
      "type": "string",
      "title": "Template Content"
    },
    "instructions": {
      "type": "string",
      "title": "Completion Instructions"
    },
    "file_url": {
      "type": "string",
      "title": "Uploaded Template File",
      "format": "uri"
    },
    "version": {
      "type": "number",
      "title": "Version",
      "default": 1
    },
    "active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "updated_by": {
      "type": "string",
      "title": "Updated By"
    },
    "updated_at": {
      "type": "string",
      "title": "Updated At",
      "format": "date-time"
    }
  },
  "required": [
    "template_type",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.tenant_id": "shared"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
