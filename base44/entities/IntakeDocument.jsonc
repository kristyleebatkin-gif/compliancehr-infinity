{
  "name": "IntakeDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "intake_case_id": {
      "type": "string",
      "title": "Intake Case ID"
    },
    "intake_case_number": {
      "type": "string",
      "title": "Intake Case Number"
    },
    "intake_type": {
      "type": "string",
      "enum": [
        "Participant",
        "Employee"
      ],
      "title": "Intake Type"
    },
    "document_type": {
      "type": "string",
      "title": "Document Type"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "profile_id": {
      "type": "string",
      "title": "Related Profile ID"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date",
      "title": "Uploaded Date"
    }
  },
  "required": [
    "intake_case_id",
    "document_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        }
      ]
    }
  }
}
