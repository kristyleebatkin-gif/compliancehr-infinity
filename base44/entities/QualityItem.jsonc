{
  "name": "QualityItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "document_number": {
      "type": "string",
      "title": "Document Number"
    },
    "version": {
      "type": "string",
      "default": "v1.0",
      "title": "Version"
    },
    "responsible_manager": {
      "type": "string",
      "title": "Responsible Manager"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "site": {
      "type": "string",
      "title": "Site / Residence"
    },
    "program": {
      "type": "string",
      "title": "Program (NDIS / Aged Care)"
    },
    "security_classification": {
      "type": "string",
      "enum": [
        "Internal",
        "Confidential",
        "Restricted Clinical",
        "Executive Safe"
      ],
      "default": "Internal",
      "title": "Security Classification"
    },
    "review_schedule": {
      "type": "string",
      "default": "Quarterly",
      "title": "Review Schedule"
    },
    "audit_history": {
      "type": "string",
      "title": "Audit History"
    },
    "type": {
      "type": "string",
      "enum": [
        "Idea",
        "Suggestion",
        "Improvement",
        "Corrective Action",
        "Preventive Action",
        "Lessons Learned"
      ],
      "default": "Improvement",
      "title": "Register Type"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "Audit",
        "Review",
        "Complaint",
        "Risk",
        "Incident",
        "Staff Suggestion",
        "Other"
      ],
      "default": "Audit",
      "title": "Linked Source Type"
    },
    "source_record_id": {
      "type": "string",
      "title": "Linked Source Record ID"
    },
    "ndis_standard": {
      "type": "string",
      "title": "NDIS Practice Standard"
    },
    "aged_care_standard": {
      "type": "string",
      "title": "Aged Care Quality Standard"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "raised_by": {
      "type": "string",
      "title": "Raised By"
    },
    "raised_date": {
      "type": "string",
      "format": "date",
      "title": "Raised Date"
    },
    "owner": {
      "type": "string",
      "title": "Owner"
    },
    "nominated_to": {
      "type": "string",
      "title": "Nominated To (Person Responsible)"
    },
    "nominated_email": {
      "type": "string",
      "title": "Nominated Person Email"
    },
    "nominated_date": {
      "type": "string",
      "format": "date",
      "title": "Nominated Date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Progress",
        "Implemented",
        "Closed"
      ],
      "default": "New",
      "title": "Status"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome / Result"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status_log": {
      "type": "string",
      "title": "Status History"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}
