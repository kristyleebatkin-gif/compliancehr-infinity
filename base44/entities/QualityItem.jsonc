{
  "name": "QualityItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "Idea",
        "Suggestion",
        "Corrective Action"
      ],
      "default": "Idea",
      "title": "Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "raised_by": {
      "type": "string",
      "title": "Raised By"
    },
    "raised_date": {
      "type": "string",
      "format": "date",
      "title": "Raised Date"
    },
    "owner": {
      "type": "string",
      "title": "Owner"
    },
    "nominated_to": {
      "type": "string",
      "title": "Nominated To (Person Responsible)"
    },
    "nominated_email": {
      "type": "string",
      "title": "Nominated Person Email"
    },
    "nominated_date": {
      "type": "string",
      "format": "date",
      "title": "Nominated Date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium",
      "title": "Priority"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Progress",
        "Implemented",
        "Closed"
      ],
      "default": "New",
      "title": "Status"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome / Result"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status_log": {
      "type": "string",
      "title": "Status History"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}