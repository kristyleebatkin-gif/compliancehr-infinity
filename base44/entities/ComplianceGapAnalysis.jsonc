{
  "name": "ComplianceGapAnalysis",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set by the compliance operations service; never from the browser."
    },
    "gap_ref": {
      "type": "string",
      "title": "Gap Reference"
    },
    "framework": {
      "type": "string",
      "title": "Framework"
    },
    "standard_id": {
      "type": "string",
      "title": "Standard Record ID"
    },
    "standard_code": {
      "type": "string",
      "title": "Standard Code"
    },
    "standard_title": {
      "type": "string",
      "title": "Standard Title"
    },
    "control_id": {
      "type": "string",
      "title": "Control Record ID"
    },
    "control_statement": {
      "type": "string",
      "title": "Control"
    },
    "gap_type": {
      "type": "string",
      "title": "Gap Type",
      "enum": [
        "No control defined",
        "Evidence missing",
        "Evidence expired",
        "Control not tested",
        "Control test failed",
        "Open finding",
        "Partial coverage"
      ],
      "enumColors": [
        "red",
        "red",
        "red",
        "yellow",
        "red",
        "pink",
        "yellow"
      ],
      "default": "Evidence missing"
    },
    "severity": {
      "type": "string",
      "title": "Severity",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "red"
      ],
      "default": "Medium"
    },
    "observation": {
      "type": "string",
      "title": "What The Records Show"
    },
    "recommendation": {
      "type": "string",
      "title": "Recommendation"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Open",
        "Remediation planned",
        "In progress",
        "Closed",
        "Risk accepted"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue",
        "green",
        "gray"
      ],
      "default": "Open"
    },
    "assessment_id": {
      "type": "string",
      "title": "Assessment ID"
    },
    "assessment_ref": {
      "type": "string",
      "title": "Assessment Reference"
    },
    "detected_on": {
      "type": "string",
      "format": "date-time",
      "title": "Detected On"
    },
    "detected_by": {
      "type": "string",
      "title": "Detected By",
      "enum": [
        "Assessment run",
        "Manual review"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "Assessment run"
    },
    "remediation_count": {
      "type": "number",
      "title": "Remediation Plans",
      "default": 0
    },
    "resolved_on": {
      "type": "string",
      "format": "date",
      "title": "Resolved On"
    },
    "resolved_by": {
      "type": "string",
      "title": "Resolved By"
    },
    "closure_note": {
      "type": "string",
      "title": "Closure Note"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "framework",
    "gap_type",
    "severity",
    "status",
    "detected_on"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}