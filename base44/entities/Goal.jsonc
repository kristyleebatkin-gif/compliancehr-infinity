{
  "name": "Goal",
  "type": "object",
  "properties": {
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "goal": {
      "type": "string",
      "title": "Goal"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "progress": {
      "type": "number",
      "title": "Progress (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "In Progress",
        "Achieved",
        "On Hold"
      ],
      "default": "In Progress",
      "title": "Status"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "support_needed": {
      "type": "string",
      "title": "Support Needed"
    },
    "admin_approved": {
      "type": "boolean",
      "default": false,
      "title": "Approved by Admin"
    }
  },
  "required": [
    "participant_name",
    "goal"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "data.participant_name": "{{user.full_name}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}