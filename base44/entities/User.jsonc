{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "Provider Administrator",
        "Compliance Manager",
        "Administration",
        "Team Leader",
        "Support Worker",
        "Participant",
        "Auditor",
        "Pending Approval",
        "Archived"
      ],
      "default": "user"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "Pending Approval",
        "Active",
        "Rejected",
        "Archived"
      ],
      "default": "Active",
      "title": "Account Status"
    },
    "requested_role": {
      "type": "string",
      "title": "Requested Role"
    },
    "approval_requested_date": {
      "type": "string",
      "format": "date",
      "title": "Approval Requested Date"
    },
    "approval_requested_time": {
      "type": "string",
      "title": "Approval Requested Time"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "title": "Approval Decision Date"
    },
    "approved_time": {
      "type": "string",
      "title": "Approval Decision Time"
    },
    "approved_by": {
      "type": "string",
      "title": "Approval Decision By"
    },
    "approved_by_user_id": {
      "type": "string",
      "title": "Approval Decision By User ID"
    },
    "previous_role": {
      "type": "string",
      "title": "Role Before Archiving"
    },
    "archived_date": {
      "type": "string",
      "format": "date",
      "title": "Archived Date"
    },
    "archived_time": {
      "type": "string",
      "title": "Archived Time"
    },
    "archive_reason": {
      "type": "string",
      "title": "Archive Reason"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}