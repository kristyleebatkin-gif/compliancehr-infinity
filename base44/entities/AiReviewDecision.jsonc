{
  "name": "AiReviewDecision",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "string"
    },
    "interaction_id": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "human_user_id": {
      "type": "string"
    },
    "human_name": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "implementation_evidence": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "decision",
    "reason",
    "human_user_id",
    "decided_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}