{
  "type": "object",
  "name": "AssetDisposal",
  "properties": {
    "asset_id": {
      "type": "string",
      "title": "Asset"
    },
    "asset_description": {
      "type": "string",
      "title": "Asset Description"
    },
    "disposal_date": {
      "type": "string",
      "title": "Disposal Date",
      "format": "date"
    },
    "reason_for_disposal": {
      "type": "string",
      "title": "Reason for Disposal"
    },
    "disposal_method": {
      "type": "string",
      "title": "Disposal Method"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "supporting_evidence": {
      "type": "string",
      "title": "Supporting Evidence (URL)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "signoff_full_name": {
      "type": "string",
      "title": "Sign-off Full Name"
    },
    "signoff_date": {
      "type": "string",
      "title": "Sign-off Date",
      "format": "date"
    },
    "signature": {
      "type": "string",
      "title": "Signature"
    }
  },
  "required": [
    "asset_description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
