{
  "name": "WorkspacePreference",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set by the workspace preferences function; never from the browser."
    },
    "user_id": {
      "type": "string",
      "title": "User ID",
      "description": "The person whose workspace this layout belongs to."
    },
    "user_name": {
      "type": "string",
      "title": "User"
    },
    "workspace_key": {
      "type": "string",
      "title": "Workspace",
      "description": "Canonical module key the layout applies to, e.g. compliance."
    },
    "workspace_label": {
      "type": "string",
      "title": "Workspace Name"
    },
    "view_state": {
      "type": "string",
      "title": "View State"
    },
    "layout_json": {
      "type": "string",
      "title": "Layout (JSON)",
      "description": "The saved shell layout: chosen view state plus section order and visibility."
    },
    "schema_version": {
      "type": "number",
      "title": "Layout Schema Version",
      "default": 1
    },
    "version_number": {
      "type": "number",
      "title": "Version",
      "default": 0,
      "description": "The latest saved version. History is append-only in WorkspacePreferenceVersion."
    },
    "content_hash": {
      "type": "string",
      "title": "Current Layout Hash"
    },
    "saved_by": {
      "type": "string",
      "title": "Last Saved By"
    },
    "saved_by_id": {
      "type": "string",
      "title": "Last Saved By (user id)"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Saved At"
    },
    "note": {
      "type": "string",
      "title": "Save Note"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "workspace_key",
    "layout_json"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}