{
  "name": "TrainingCompletion",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "Employee"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "learner_type": {
      "type": "string",
      "enum": [
        "Employee",
        "Participant"
      ],
      "default": "Employee",
      "title": "Learner Type"
    },
    "learner_id": {
      "type": "string",
      "title": "Learner ID"
    },
    "learner_name": {
      "type": "string",
      "title": "Learner Name"
    },
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "training_module_id": {
      "type": "string",
      "title": "Training Module"
    },
    "module_title": {
      "type": "string",
      "title": "Module Title"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Expiry Date"
    },
    "score": {
      "type": "number",
      "title": "Score (%)"
    },
    "certificate_number": {
      "type": "string",
      "title": "Certificate Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Completed",
        "Archived"
      ],
      "default": "Completed",
      "title": "Status"
    },
    "training_notes": {
      "type": "string",
      "title": "Training Notes"
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "title": "Audit Consent",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    }
  },
  "required": [
    "employee_name",
    "module_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "data.employee_name": "{{user.full_name}}"
        },
        {
          "data.learner_name": "{{user.full_name}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "data.audit_consent": "Audit consent received"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}