{
  "name": "AuditChecklistFile",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "checklist_title": {
      "type": "string",
      "title": "Source Checklist"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
