{
  "name": "AutomationEventType",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the automation fabric service; never from the browser."
    },
    "event_key": {
      "type": "string",
      "title": "Event Key",
      "description": "Stable dotted key the fabric routes on, e.g. incident.created."
    },
    "name": {
      "type": "string",
      "title": "Event Name"
    },
    "description": {
      "type": "string",
      "title": "What This Event Means"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Compliance",
        "Workforce",
        "Incident",
        "Risk",
        "Finance",
        "Governance",
        "Integration",
        "System"
      ],
      "enumColors": [
        "blue",
        "teal",
        "red",
        "orange",
        "green",
        "purple",
        "gray",
        "gray"
      ],
      "default": "Compliance"
    },
    "domain": {
      "type": "string",
      "title": "Operating Area",
      "description": "Which operating system produces the event."
    },
    "source_module": {
      "type": "string",
      "title": "Producing Module"
    },
    "schema_version": {
      "type": "number",
      "title": "Payload Schema Version",
      "default": 1,
      "description": "Bumped whenever the payload contract changes. A subscription records the version it was written against."
    },
    "payload_schema_json": {
      "type": "string",
      "title": "Payload Fields (JSON)",
      "description": "Field name, type and required flag. Validation uses exactly this, so a malformed event is refused before routing."
    },
    "required_fields_json": {
      "type": "string",
      "title": "Required Fields (JSON)"
    },
    "field_count": {
      "type": "number",
      "title": "Declared Fields",
      "default": 0
    },
    "sensitivity": {
      "type": "string",
      "title": "Sensitivity",
      "description": "Confidential and Restricted payloads are redacted before storage, and the redacted field names are recorded.",
      "enum": [
        "Public",
        "Internal",
        "Confidential",
        "Restricted"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "red"
      ],
      "default": "Internal"
    },
    "is_system": {
      "type": "boolean",
      "title": "Seeded Catalogue Entry",
      "default": false,
      "description": "True when the type came from the app's own catalogue rather than a person."
    },
    "sample_payload_json": {
      "type": "string",
      "title": "Example Payload (JSON)"
    },
    "retention_days": {
      "type": "number",
      "title": "Delivery Retention (days)",
      "default": 365
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "Retired"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "Active"
    },
    "version": {
      "type": "number",
      "title": "Version",
      "default": 1
    },
    "author": {
      "type": "string",
      "title": "Author"
    },
    "author_id": {
      "type": "string",
      "title": "Author (user id)"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time",
      "title": "Retired At"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "event_key",
    "name",
    "category",
    "schema_version",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}