{
  "name": "SafetyCheck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "check_type": {
      "type": "string",
      "enum": [
        "Smoke Alarm Test",
        "Fire Safety Equipment Check",
        "Fire Extinguisher Check",
        "Emergency Lighting Test",
        "Natural Disaster Kit Check",
        "First Aid Kit Check",
        "First Aid Check",
        "MSDS Review",
        "Evacuation Drill",
        "Other"
      ],
      "default": "Smoke Alarm Test",
      "title": "Check Type"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "date_completed": {
      "type": "string",
      "format": "date",
      "title": "Date Completed"
    },
    "next_due_date": {
      "type": "string",
      "format": "date",
      "title": "Next Due (6 months)"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By"
    },
    "result": {
      "type": "string",
      "enum": [
        "Pass",
        "Issues Found",
        "Scheduled"
      ],
      "default": "Pass",
      "title": "Result"
    },
    "issues_found": {
      "type": "string",
      "title": "Issues Found"
    },
    "action_taken": {
      "type": "string",
      "title": "Action Taken"
    },
    "file_uri": {
      "type": "string",
      "title": "Record File URI"
    },
    "file_name": {
      "type": "string",
      "title": "Record File Name"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Employee"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        },
        {
          "user_condition": {
            "role": "Employee"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Employee"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Employee"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}