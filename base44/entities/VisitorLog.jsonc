{
  "name": "VisitorLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "visitor_name": {
      "type": "string",
      "title": "Name (Employee / Contractor / Visitor / Volunteer)"
    },
    "attendance_type": {
      "type": "string",
      "enum": [
        "Employee",
        "Manager",
        "Executive",
        "Contractor",
        "Volunteer",
        "Visitor",
        "Auditor",
        "Consultant",
        "Service Provider"
      ],
      "default": "Visitor",
      "title": "Attendance Category"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee / Contractor ID"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "position": {
      "type": "string",
      "title": "Position / Role"
    },
    "site": {
      "type": "string",
      "default": "Head Office",
      "title": "Site / Facility"
    },
    "building": {
      "type": "string",
      "default": "Main Building",
      "title": "Building"
    },
    "areas_accessed": {
      "type": "string",
      "title": "Areas Accessed"
    },
    "program": {
      "type": "string",
      "default": "NDIS & Aged Care",
      "title": "Program"
    },
    "manager": {
      "type": "string",
      "title": "Responsible Manager"
    },
    "organisation": {
      "type": "string",
      "title": "Company / Organisation"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "vehicle_registration": {
      "type": "string",
      "title": "Vehicle Registration"
    },
    "host": {
      "type": "string",
      "title": "Host Employee / Met With"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time_in": {
      "type": "string",
      "title": "Sign In / Arrival Time"
    },
    "time_out": {
      "type": "string",
      "title": "Sign Out / Departure Time"
    },
    "break_start": {
      "type": "string",
      "title": "Break Start"
    },
    "break_end": {
      "type": "string",
      "title": "Break End"
    },
    "total_hours": {
      "type": "number",
      "title": "Total Hours"
    },
    "attendance_exceptions": {
      "type": "string",
      "title": "Attendance Exceptions / Flags"
    },
    "site_transfer_to": {
      "type": "string",
      "title": "Site Transfer Destination"
    },
    "after_hours": {
      "type": "boolean",
      "default": false,
      "title": "After Hours Attendance"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose of Attendance / Duties Performed"
    },
    "contractor_trade": {
      "type": "string",
      "title": "Contractor Trade Details"
    },
    "contractor_insurance": {
      "type": "string",
      "title": "Contractor Insurance Details"
    },
    "contractor_qualifications": {
      "type": "string",
      "title": "Contractor Qualifications & Licences"
    },
    "id_verified": {
      "type": "boolean",
      "default": true,
      "title": "Identification Verified"
    },
    "badge_number": {
      "type": "string",
      "title": "Visitor / Site Badge Number"
    },
    "photo_uri": {
      "type": "string",
      "title": "Photograph Private URI"
    },
    "first_aid_officer": {
      "type": "boolean",
      "default": false,
      "title": "First Aid Officer On Site"
    },
    "fire_warden": {
      "type": "boolean",
      "default": false,
      "title": "Fire Warden On Site"
    },
    "manager_on_site": {
      "type": "boolean",
      "default": false,
      "title": "Manager On Site"
    },
    "ack_privacy": {
      "type": "boolean",
      "default": true,
      "title": "Privacy Notice Acknowledged"
    },
    "ack_confidentiality": {
      "type": "boolean",
      "default": true,
      "title": "Confidentiality Notice Acknowledged"
    },
    "ack_whs": {
      "type": "boolean",
      "default": true,
      "title": "WHS Information Acknowledged"
    },
    "ack_emergency": {
      "type": "boolean",
      "default": true,
      "title": "Emergency Procedures Acknowledged"
    },
    "ack_conditions": {
      "type": "boolean",
      "default": true,
      "title": "Visitor / Site Conditions Acknowledged"
    },
    "digital_signature": {
      "type": "string",
      "title": "Digital Signature"
    },
    "sign_in_method": {
      "type": "string",
      "enum": [
        "QR Code",
        "Mobile",
        "Kiosk",
        "Tablet",
        "Web Desk"
      ],
      "default": "Kiosk",
      "title": "Sign-In Method"
    },
    "emergency_accountability_status": {
      "type": "string",
      "enum": [
        "Present",
        "Accounted For",
        "Not Accounted For",
        "Signed Out",
        "Off Site"
      ],
      "default": "Present",
      "title": "Emergency Roll Call Status"
    },
    "emergency_event_type": {
      "type": "string",
      "title": "Emergency Event Type"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "visitor_name",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}
