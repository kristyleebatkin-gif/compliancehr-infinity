{
  "type": "object",
  "name": "AssetComplianceReview",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "review_date": {
      "type": "string",
      "title": "Review Date",
      "format": "date"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed By"
    },
    "register_status": {
      "type": "string",
      "title": "Register Status",
      "enum": [
        "Up to Date",
        "Action Required",
        "Overdue",
        "Completed"
      ],
      "default": "Up to Date"
    },
    "actions_required": {
      "type": "string",
      "title": "Actions Required"
    },
    "completion_date": {
      "type": "string",
      "title": "Completion Date",
      "format": "date"
    },
    "signature": {
      "type": "string",
      "title": "Signature"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "signoff_full_name": {
      "type": "string",
      "title": "Sign-off Full Name"
    },
    "signoff_date": {
      "type": "string",
      "title": "Sign-off Date",
      "format": "date"
    }
  },
  "required": [
    "review_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
