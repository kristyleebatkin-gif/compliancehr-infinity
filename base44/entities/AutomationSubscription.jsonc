{
  "name": "AutomationSubscription",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the automation fabric service; never from the browser."
    },
    "subscription_key": {
      "type": "string",
      "title": "Subscription Key"
    },
    "name": {
      "type": "string",
      "title": "Subscription Name"
    },
    "description": {
      "type": "string",
      "title": "What This Subscription Does"
    },
    "event_type_key": {
      "type": "string",
      "title": "Event Key"
    },
    "event_type_name": {
      "type": "string",
      "title": "Event"
    },
    "event_schema_version": {
      "type": "number",
      "title": "Event Schema Version Subscribed"
    },
    "target_kind": {
      "type": "string",
      "title": "Delivers To",
      "enum": [
        "Workflow",
        "Automation flow",
        "Record only"
      ],
      "enumColors": [
        "purple",
        "blue",
        "gray"
      ],
      "default": "Workflow",
      "description": "Workflow starts an existing published Workflow Studio version. Automation flow follows the flow's ordered steps. Record only keeps the message in the history."
    },
    "workflow_definition_id": {
      "type": "string",
      "title": "Workflow Definition ID"
    },
    "workflow_definition_name": {
      "type": "string",
      "title": "Workflow"
    },
    "flow_id": {
      "type": "string",
      "title": "Automation Flow ID"
    },
    "flow_name": {
      "type": "string",
      "title": "Automation Flow"
    },
    "connector_id": {
      "type": "string",
      "title": "Integration Connector ID"
    },
    "connector_name": {
      "type": "string",
      "title": "Integration Connector"
    },
    "filters_json": {
      "type": "string",
      "title": "Filters (JSON)",
      "description": "Conditions the payload must meet before this subscription is eligible."
    },
    "filter_count": {
      "type": "number",
      "title": "Filters",
      "default": 0
    },
    "delivery_mode": {
      "type": "string",
      "title": "Delivery Mode",
      "enum": [
        "Immediate"
      ],
      "enumColors": [
        "green"
      ],
      "default": "Immediate"
    },
    "max_attempts": {
      "type": "number",
      "title": "Maximum Attempts",
      "default": 3
    },
    "rate_limit_per_minute": {
      "type": "number",
      "title": "Rate Limit (per minute)",
      "default": 60
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Active",
        "Paused",
        "Retired"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "Active"
    },
    "version": {
      "type": "number",
      "title": "Version",
      "default": 1
    },
    "delivery_count": {
      "type": "number",
      "title": "Deliveries",
      "default": 0
    },
    "failure_count": {
      "type": "number",
      "title": "Failed Deliveries",
      "default": 0
    },
    "last_delivery_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Delivery"
    },
    "created_by_name": {
      "type": "string",
      "title": "Created By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "subscription_key",
    "name",
    "event_type_key",
    "target_kind",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "Provider Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Compliance Administrator"
                  }
                },
                {
                  "user_condition": {
                    "role": "Management"
                  }
                },
                {
                  "user_condition": {
                    "role": "Administration"
                  }
                },
                {
                  "user_condition": {
                    "role": "Quality & Improvement Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Auditor"
                  }
                }
              ]
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "account_status": "Active",
                "access_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}