{
  "type": "object",
  "name": "ReceiptRecord",
  "properties": {
    "receipt_date": {
      "type": "string",
      "title": "Receipt Date",
      "format": "date"
    },
    "receipt_time": {
      "type": "string",
      "title": "Receipt Time",
      "format": "time"
    },
    "supplier": {
      "type": "string",
      "title": "Supplier"
    },
    "supplier_abn": {
      "type": "string",
      "title": "Supplier ABN"
    },
    "supplier_address": {
      "type": "string",
      "title": "Supplier Address"
    },
    "supplier_phone": {
      "type": "string",
      "title": "Supplier Phone"
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number"
    },
    "transaction_reference": {
      "type": "string",
      "title": "Transaction Reference"
    },
    "item_description": {
      "type": "string",
      "title": "Item or Service Description"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity"
    },
    "unit_price": {
      "type": "number",
      "title": "Unit Price"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "discount_amount": {
      "type": "number",
      "title": "Discount Amount"
    },
    "category": {
      "type": "string",
      "enum": [
        "Participant Expense",
        "Office",
        "Travel",
        "Training",
        "Equipment",
        "Maintenance",
        "Other"
      ],
      "default": "Other"
    },
    "amount": {
      "type": "number",
      "title": "Total Amount"
    },
    "gst_amount": {
      "type": "number",
      "title": "GST Amount"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Company Card",
        "Personal Card",
        "Cash",
        "Bank Transfer",
        "Other"
      ],
      "default": "Company Card"
    },
    "purchased_by": {
      "type": "string",
      "title": "Purchased By"
    },
    "entered_by_employee_id": {
      "type": "string",
      "title": "Entered By Employee ID"
    },
    "entered_by_employee_name": {
      "type": "string",
      "title": "Entered By Employee"
    },
    "entered_by_user_id": {
      "type": "string",
      "title": "Entered By User ID"
    },
    "participant_id": {
      "type": "string",
      "title": "Related Participant ID"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant Name"
    },
    "participant_user_id": {
      "type": "string",
      "title": "Related Participant User ID"
    },
    "cost_centre": {
      "type": "string",
      "title": "Cost Centre"
    },
    "ndis_support_item_code": {
      "type": "string",
      "title": "NDIS Support Item Code"
    },
    "purpose": {
      "type": "string",
      "title": "Business Purpose"
    },
    "file_url": {
      "type": "string",
      "title": "Receipt File",
      "format": "uri"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Approved",
        "Reimbursed",
        "Rejected",
        "Reconciled"
      ],
      "default": "Pending Review"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approval_date": {
      "type": "string",
      "title": "Approval Date",
      "format": "date"
    },
    "reconciled_at": {
      "type": "string",
      "title": "Reconciled At",
      "format": "date-time"
    },
    "reconciled_by": {
      "type": "string",
      "title": "Reconciled By"
    },
    "reconciled_by_user_id": {
      "type": "string",
      "title": "Reconciled By User ID"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "receipt_date",
    "supplier",
    "item_description",
    "amount",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      ]
    }
  }
}