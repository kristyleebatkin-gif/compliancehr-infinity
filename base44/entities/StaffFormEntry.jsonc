{
  "name": "StaffFormEntry",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "title": "Staff",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        }
      }
    },
    "staff_name": {
      "type": "string",
      "title": "Staff Name"
    },
    "form_type": {
      "type": "string",
      "title": "Form Type"
    },
    "form_code": {
      "type": "string",
      "title": "Form Code"
    },
    "answers": {
      "type": "string",
      "title": "Answers (JSON)"
    },
    "completed_by": {
      "type": "string",
      "title": "Completed By"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "staff_id",
    "form_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "$and": [
            {
              "data.staff_id": {
                "$ne": null
              }
            },
            {
              "data.staff_id": "{{user.data.personal_staff_profile_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "$and": [
            {
              "data.staff_id": {
                "$ne": null
              }
            },
            {
              "data.staff_id": "{{user.data.personal_staff_profile_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "$and": [
            {
              "data.staff_id": {
                "$ne": null
              }
            },
            {
              "data.staff_id": "{{user.data.personal_staff_profile_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        }
      ]
    }
  }
}