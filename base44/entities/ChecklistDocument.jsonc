{
  "type": "object",
  "name": "ChecklistDocument",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID — \"shared\" for master templates",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "template_key": {
      "type": "string",
      "title": "Template Key"
    },
    "title": {
      "type": "string",
      "title": "Form Title"
    },
    "module_type": {
      "type": "string",
      "title": "Module",
      "enum": [
        "Checklists",
        "Emergency Response",
        "Meeting Centre",
        "Data Control Panel"
      ]
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "file_url": {
      "type": "string",
      "title": "Uploaded File"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "upload_date": {
      "type": "string",
      "title": "Upload Date",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Uploaded",
        "Reviewed",
        "Archived"
      ],
      "default": "Uploaded"
    }
  },
  "required": [
    "template_key",
    "title",
    "module_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
