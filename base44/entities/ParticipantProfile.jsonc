{
  "name": "ParticipantProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            }
          ]
        }
      }
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "ndis_number": {
      "type": "string",
      "title": "NDIS Number"
    },
    "ndis_reference_number": {
      "type": "string",
      "title": "NDIS Reference Number"
    },
    "support_coordinator": {
      "type": "string",
      "title": "Support Coordination"
    },
    "plan_manager": {
      "type": "string",
      "title": "Plan Manager"
    },
    "plan_manager_email": {
      "type": "string",
      "format": "email",
      "title": "Plan Manager Email"
    },
    "plan_budget_total": {
      "type": "number",
      "title": "Plan Budget Total ($)"
    },
    "plan_start_date": {
      "type": "string",
      "format": "date",
      "title": "Plan Start Date"
    },
    "plan_end_date": {
      "type": "string",
      "format": "date",
      "title": "Plan End Date"
    },
    "advocate_representative": {
      "type": "string",
      "title": "Advocate / Representative"
    },
    "emergency_contact": {
      "type": "string",
      "title": "Emergency Contact"
    },
    "emergency_contact_phone": {
      "type": "string",
      "title": "Emergency Contact Phone"
    },
    "medical_diagnosis": {
      "type": "string",
      "title": "Medical Diagnosis"
    },
    "triggers": {
      "type": "string",
      "title": "Triggers"
    },
    "risks": {
      "type": "string",
      "title": "Risks"
    },
    "control_measures": {
      "type": "string",
      "title": "Control Measures"
    },
    "occupational_therapist": {
      "type": "string",
      "title": "Occupational Therapist"
    },
    "support_shifts": {
      "type": "string",
      "title": "Support Shifts"
    },
    "support_staff": {
      "type": "string",
      "title": "Support Staff"
    },
    "profile_photo_uri": {
      "type": "string",
      "title": "Profile Photo (File URI)"
    },
    "about_me": {
      "type": "string",
      "title": "About Me"
    },
    "change_log": {
      "type": "string",
      "title": "Details Check & Change Log"
    },
    "last_details_check_date": {
      "type": "string",
      "format": "date",
      "title": "Last Details Check Requested"
    },
    "likes": {
      "type": "string",
      "title": "Likes"
    },
    "dislikes": {
      "type": "string",
      "title": "Dislikes"
    },
    "routine": {
      "type": "string",
      "title": "Routine"
    },
    "support_type": {
      "type": "string",
      "title": "Type of Support Provided"
    },
    "fire_drill": {
      "type": "string",
      "title": "Fire Drill"
    },
    "medications_dosage": {
      "type": "string",
      "title": "Medications and Dosage"
    },
    "support_team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Support Worker Team",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        }
      }
    },
    "last_progress_copy_date": {
      "type": "string",
      "format": "date",
      "title": "Last Progress Copy Sent (10 Weekly)"
    },
    "progress_notes_due_date": {
      "type": "string",
      "format": "date",
      "title": "Progress Notes Due (3 Monthly)"
    },
    "progress_email_log": {
      "type": "string",
      "title": "Progress Email Log"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Hold",
        "Inactive"
      ],
      "default": "Active",
      "title": "Status"
    },
    "admin_approved": {
      "type": "boolean",
      "default": false,
      "title": "Approved by Admin",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            }
          ]
        }
      }
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "title": "Audit Consent",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "audit_consent_recorded_by": {
      "type": "string",
      "title": "Audit Consent Recorded By",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "audit_consent_recorded_date": {
      "type": "string",
      "title": "Audit Consent Recorded Date",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "audit_consent_recorded_time": {
      "type": "string",
      "title": "Audit Consent Recorded Time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "sharing_consent": {
      "type": "object",
      "title": "Consent to Share Information",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Consent received",
            "Declined",
            "Withdrawn"
          ]
        },
        "granted_by": {
          "type": "string"
        },
        "authorised_person": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recorded_by": {
          "type": "string"
        },
        "recorded_by_user_id": {
          "type": "string"
        },
        "recorded_date": {
          "type": "string"
        },
        "recorded_time": {
          "type": "string"
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "advocacy_consent": {
      "type": "object",
      "title": "Consent to Act as an Advocate",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Consent received",
            "Declined",
            "Withdrawn"
          ]
        },
        "granted_by": {
          "type": "string"
        },
        "authorised_person": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recorded_by": {
          "type": "string"
        },
        "recorded_by_user_id": {
          "type": "string"
        },
        "recorded_date": {
          "type": "string"
        },
        "recorded_time": {
          "type": "string"
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "medication_consent": {
      "type": "object",
      "title": "Medication Consent",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Consent received",
            "Declined",
            "Withdrawn"
          ]
        },
        "granted_by": {
          "type": "string"
        },
        "authorised_person": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recorded_by": {
          "type": "string"
        },
        "recorded_by_user_id": {
          "type": "string"
        },
        "recorded_date": {
          "type": "string"
        },
        "recorded_time": {
          "type": "string"
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "data.admin_approved": true
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Employee"
              }
            },
            {
              "data.admin_approved": true
            }
          ]
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Participant"
              }
            },
            {
              "data.email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        }
      ]
    }
  }
}