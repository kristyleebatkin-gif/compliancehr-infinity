{
  "name": "FormSubmission",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "form_template_id": {
      "type": "string",
      "title": "Form Template"
    },
    "form_title": {
      "type": "string",
      "title": "Form Title"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "submitted_by": {
      "type": "string",
      "title": "Submitted By"
    },
    "saved_by_user_id": {
      "type": "string",
      "title": "Draft Owner User ID"
    },
    "online_document": {
      "type": "boolean",
      "default": false,
      "title": "Online Library Document"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "title": "Submitted Date"
    },
    "submission_method": {
      "type": "string",
      "enum": [
        "Online",
        "Upload",
        "Imported"
      ],
      "default": "Online",
      "title": "Submission Method"
    },
    "submitted_document_url": {
      "type": "string",
      "title": "Submitted Document URL"
    },
    "participant_id": {
      "type": "string",
      "title": "Related Participant",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        }
      }
    },
    "employee_id": {
      "type": "string",
      "title": "Related Employee"
    },
    "intake_case_id": {
      "type": "string",
      "title": "Related Intake Case"
    },
    "data": {
      "type": "string",
      "title": "Submission Data (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Reviewed",
        "Actioned"
      ],
      "default": "Submitted",
      "title": "Status"
    },
    "review_notes": {
      "type": "string",
      "title": "Review Notes"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "title": "Reviewed Date"
    },
    "review_outcome": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Approved",
        "Changes Required",
        "Rejected"
      ],
      "default": "Pending Review",
      "title": "Review Outcome"
    },
    "submission_summary": {
      "type": "string",
      "title": "Submission Outcome / Summary"
    },
    "audit_consent": {
      "type": "string",
      "enum": [
        "Audit consent received",
        "Audit declined"
      ],
      "default": "Audit declined",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    }
  },
  "required": [
    "form_title",
    "submitted_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Participant"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.participant_id": "{{user.data.personal_participant_profile_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.saved_by_user_id": "{{user.id}}"
            },
            {
              "data.online_document": true
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "Human Resources Manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "Team Leader"
                  }
                },
                {
                  "user_condition": {
                    "role": "Intake Officer"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "$and": [
            {
              "data.status": "Draft"
            },
            {
              "data.saved_by_user_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.online_document": true
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Participant"
              }
            },
            {
              "data.participant_id": {
                "$ne": null
              }
            },
            {
              "data.participant_id": "{{user.data.personal_participant_profile_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "data.category": {
                "$nin": [
                  "Participant Intake",
                  "Employee Intake"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "data.category": {
                "$nin": [
                  "Participant Intake",
                  "Employee Intake"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "data.category": {
                "$nin": [
                  "Participant Intake",
                  "Employee Intake"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Auditor"
              }
            },
            {
              "data.category": {
                "$nin": [
                  "Participant Intake",
                  "Employee Intake"
                ]
              }
            },
            {
              "data.audit_consent": "Audit consent received"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Participant"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.online_document": true
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}
