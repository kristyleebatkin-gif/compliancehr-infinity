{
  "type": "object",
  "name": "EmployeeTimesheet",
  "properties": {
    "timesheet_number": {
      "type": "string",
      "title": "Timesheet Number"
    },
    "staff_profile_id": {
      "type": "string",
      "title": "Staff Profile"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee"
    },
    "period_start": {
      "type": "string",
      "title": "Period Start",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "title": "Period End",
      "format": "date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Generated",
        "Approved",
        "Exported"
      ],
      "default": "Draft"
    },
    "shift_lines": {
      "type": "array",
      "title": "Timesheet Shift Lines",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "shift_id": {
            "type": "string"
          },
          "shift_date": {
            "type": "string",
            "format": "date"
          },
          "participant_name": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "kms": {
            "type": "number"
          },
          "day_type": {
            "type": "string"
          },
          "sleepover": {
            "type": "boolean"
          },
          "split_shift": {
            "type": "boolean"
          }
        }
      }
    },
    "weekday_hours": {
      "type": "number",
      "title": "Weekday Hours",
      "default": 0
    },
    "saturday_hours": {
      "type": "number",
      "title": "Saturday Hours",
      "default": 0
    },
    "sunday_hours": {
      "type": "number",
      "title": "Sunday Hours",
      "default": 0
    },
    "public_holiday_hours": {
      "type": "number",
      "title": "Public Holiday Hours",
      "default": 0
    },
    "sleepover_count": {
      "type": "number",
      "title": "Sleepovers",
      "default": 0
    },
    "split_shift_days": {
      "type": "number",
      "title": "Split Shift Days",
      "default": 0
    },
    "total_hours": {
      "type": "number",
      "title": "Total Hours",
      "default": 0
    },
    "total_kms": {
      "type": "number",
      "title": "Total KMS",
      "default": 0
    },
    "pdf_url": {
      "type": "string",
      "title": "Timesheet PDF",
      "format": "uri"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By"
    },
    "generated_at": {
      "type": "string",
      "title": "Generated At",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "timesheet_number",
    "staff_profile_id",
    "employee_name",
    "period_start",
    "period_end"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}