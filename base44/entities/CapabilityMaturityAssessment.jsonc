{
  "name": "CapabilityMaturityAssessment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Stamped by the strategy service; never from the browser."
    },
    "assessment_ref": {
      "type": "string",
      "title": "Assessment Reference"
    },
    "capability_id": {
      "type": "string",
      "title": "Capability Record ID"
    },
    "capability_key": {
      "type": "string",
      "title": "Capability Reference"
    },
    "capability_name": {
      "type": "string",
      "title": "Capability"
    },
    "assessor": {
      "type": "string",
      "title": "Assessor"
    },
    "assessor_id": {
      "type": "string",
      "title": "Assessor (user id)"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Assessed At"
    },
    "score": {
      "type": "number",
      "title": "Maturity Score (1-5)"
    },
    "rationale": {
      "type": "string",
      "title": "Rationale",
      "description": "Why this score. This field is the record of the assessor's judgement."
    },
    "evidence_refs_json": {
      "type": "string",
      "title": "Evidence References (JSON)",
      "description": "References to the evidence behind the score. A score of 4 or 5 requires at least one."
    },
    "evidence_count": {
      "type": "number",
      "title": "Evidence References",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "Validated",
        "Archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "gray"
      ],
      "default": "Draft"
    },
    "validated_by": {
      "type": "string",
      "title": "Validated By"
    },
    "validated_by_id": {
      "type": "string",
      "title": "Validated By (user id)"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Validated At"
    },
    "validation_note": {
      "type": "string",
      "title": "Validation Note"
    },
    "next_review": {
      "type": "string",
      "format": "date",
      "title": "Next Review"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "tenant_id",
    "assessment_ref",
    "capability_id",
    "assessor",
    "assessed_at",
    "score",
    "rationale",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "user_condition": {
            "account_status": "Active",
            "access_approved": true
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "__service_role_only__"
          }
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}