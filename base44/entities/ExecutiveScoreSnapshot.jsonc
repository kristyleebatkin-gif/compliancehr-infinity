{
  "name": "ExecutiveScoreSnapshot",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "title": "Snapshot Date"
    },
    "organisation_health_score": {
      "type": "number",
      "title": "Organisation Health Score (%)"
    },
    "compliance_score": {
      "type": "number",
      "title": "Compliance Score (%)"
    },
    "workforce_score": {
      "type": "number",
      "title": "Workforce Score (%)"
    },
    "risk_score": {
      "type": "number",
      "title": "Risk Score (%)"
    },
    "quality_score": {
      "type": "number",
      "title": "Quality Score (%)"
    },
    "metrics_summary_json": {
      "type": "string",
      "title": "Contributing Metrics Summary (JSON)"
    },
    "recorded_by": {
      "type": "string",
      "title": "Recorded By"
    },
    "notes": {
      "type": "string",
      "title": "Snapshot Notes"
    }
  },
  "required": [
    "snapshot_date",
    "organisation_health_score"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Management"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
