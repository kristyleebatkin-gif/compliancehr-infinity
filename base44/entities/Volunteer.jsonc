{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "role": {
      "type": "string",
      "title": "Volunteer Role"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Onboarding",
        "Active",
        "Inactive"
      ],
      "default": "Onboarding",
      "title": "Status"
    },
    "supervisor": {
      "type": "string",
      "title": "Supervisor"
    },
    "weekly_hours": {
      "type": "number",
      "title": "Weekly Hours"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "full_name"
  ]
}