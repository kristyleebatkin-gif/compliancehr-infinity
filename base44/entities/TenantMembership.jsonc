{
  "name": "TenantMembership",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "title": "Organisation ID"
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "title": "User Email"
    },
    "membership_role": {
      "type": "string",
      "title": "Tenant Role",
      "enum": [
        "admin",
        "Provider Administrator",
        "Compliance Manager",
        "Human Resources Manager",
        "Quality & Improvement Manager",
        "Finance & Accounts Officer",
        "Rostering Coordinator",
        "Team Leader",
        "Intake Officer",
        "CRM & Marketing Officer",
        "Administration",
        "Support Worker",
        "Employee",
        "Volunteer",
        "Participant",
        "Auditor"
      ],
      "enumColors": [
        "purple",
        "purple",
        "blue",
        "blue",
        "blue",
        "green",
        "blue",
        "blue",
        "blue",
        "pink",
        "blue",
        "green",
        "green",
        "yellow",
        "pink",
        "gray"
      ],
      "default": "Support Worker"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Invited",
        "Active",
        "Suspended",
        "Ended"
      ],
      "enumColors": [
        "blue",
        "green",
        "red",
        "gray"
      ],
      "default": "Invited"
    },
    "starts_on": {
      "type": "string",
      "format": "date",
      "title": "Starts On"
    },
    "ends_on": {
      "type": "string",
      "format": "date",
      "title": "Ends On"
    },
    "invited_by_user_id": {
      "type": "string",
      "title": "Invited By User ID"
    },
    "mfa_enforced": {
      "type": "boolean",
      "default": true,
      "title": "MFA Enforced"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "organisation_id",
    "tenant_id",
    "user_id",
    "membership_role",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.organisation_id": "{{user.data.organisation_id}}"
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            }
          ]
        }
      ]
    }
  }
}