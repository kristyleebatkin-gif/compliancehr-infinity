{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "Program",
        "Event"
      ],
      "default": "Program",
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "attendees": {
      "type": "string",
      "title": "Attendees"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "Ongoing",
        "Completed",
        "Cancelled"
      ],
      "default": "Planned",
      "title": "Status"
    },
    "organiser": {
      "type": "string",
      "title": "Organiser"
    },
    "contact_email": {
      "type": "string",
      "title": "Contact Email"
    },
    "cost_text": {
      "type": "string",
      "title": "Cost"
    },
    "ad_headline": {
      "type": "string",
      "title": "Ad Headline"
    },
    "ad_body": {
      "type": "string",
      "title": "Advertisement Body"
    },
    "ad_cta": {
      "type": "string",
      "title": "Ad Call To Action"
    },
    "ad_image_url": {
      "type": "string",
      "title": "Ad Image URL"
    },
    "invited_to": {
      "type": "string",
      "title": "Invites Sent To"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "title": "Invites Sent At"
    }
  },
  "required": [
    "title"
  ]
}