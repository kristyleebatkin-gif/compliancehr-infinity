{
  "name": "Shift",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "title": "Employee (blank = unassigned)"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed",
        "Missed",
        "Cancelled"
      ],
      "default": "Scheduled",
      "title": "Status"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Personal Care",
        "Community Access",
        "Domestic Assistance",
        "Transport",
        "Respite",
        "Social Support",
        "Other"
      ],
      "title": "Service Type"
    },
    "funding_source": {
      "type": "string",
      "enum": [
        "NDIS Core Supports",
        "NDIS Capacity Building",
        "NDIS Capital",
        "Private",
        "Other"
      ],
      "title": "Funding Source"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "location_lat": {
      "type": "number",
      "title": "Location Pin (Lat)"
    },
    "location_lng": {
      "type": "number",
      "title": "Location Pin (Lng)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "break_minutes": {
      "type": "number",
      "title": "Unpaid Break (min)"
    },
    "travel_km": {
      "type": "number",
      "title": "Travel (km)"
    },
    "billable_rate": {
      "type": "number",
      "title": "Billable Rate ($/hr)"
    },
    "participant_goal": {
      "type": "string",
      "title": "Shift Goal"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Not Required",
        "Pending Approval",
        "Approved",
        "Rejected"
      ],
      "default": "Not Required",
      "title": "Approval Status"
    },
    "staff_confirmation": {
      "type": "string",
      "enum": [
        "Pending Confirmation",
        "Confirmed",
        "Declined"
      ],
      "default": "Pending Confirmation",
      "title": "Staff Confirmation"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "title": "Clock In"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "title": "Clock Out"
    },
    "clock_in_location": {
      "type": "string",
      "title": "Clock-in GPS"
    },
    "clock_out_location": {
      "type": "string",
      "title": "Clock-out GPS"
    },
    "location_verified": {
      "type": "string",
      "title": "Location Check"
    },
    "repeat_rule": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "fortnightly"
      ],
      "title": "Repeat Rule"
    },
    "repeat_until": {
      "type": "string",
      "format": "date",
      "title": "Repeat Until"
    },
    "invoiced": {
      "type": "boolean",
      "default": false,
      "title": "Invoiced"
    },
    "invoice_id": {
      "type": "string",
      "title": "Linked Invoice ID"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "title": "Reminder Sent"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        }
      ]
    }
  }
}