{
  "name": "Shift",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "title": "Employee"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Completed",
        "Missed",
        "Cancelled"
      ],
      "default": "Scheduled",
      "title": "Status"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "employee_name",
    "date"
  ]
}