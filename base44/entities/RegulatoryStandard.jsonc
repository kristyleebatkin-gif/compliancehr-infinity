{
  "name": "RegulatoryStandard",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "framework": {
      "type": "string",
      "enum": [
        "NDIS Practice Standards",
        "Aged Care Quality Standards",
        "ISO 9001:2015",
        "ISO/IEC 27001:2022",
        "NSQHS Standards",
        "HSQF",
        "Fair Work"
      ],
      "default": "NDIS Practice Standards",
      "title": "Framework",
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray",
        "pink",
        "yellow",
        "gray"
      ]
    },
    "legislation": {
      "type": "string",
      "title": "Legislation / Source"
    },
    "standard_code": {
      "type": "string",
      "title": "Standard Code",
      "description": "Short reference used across the assurance chain, e.g. Core 1.1."
    },
    "standard_title": {
      "type": "string",
      "title": "Standard Title"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome"
    },
    "indicator": {
      "type": "string",
      "title": "Indicator"
    },
    "module_area": {
      "type": "string",
      "title": "Operating Area"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retired"
      ],
      "default": "Active",
      "title": "Status",
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "red"
      ]
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "title": "Effective Date"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Next Review Date"
    },
    "version": {
      "type": "string",
      "title": "Version",
      "default": "1.0"
    },
    "source_url": {
      "type": "string",
      "title": "Source Reference URL"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "framework",
    "standard_code",
    "standard_title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Auditor"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Management"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Administrator"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}