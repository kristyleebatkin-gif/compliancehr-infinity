{
  "name": "VolunteerTraining",
  "type": "object",
  "properties": {
    "volunteer_id": {
      "type": "string",
      "title": "Volunteer"
    },
    "volunteer_name": {
      "type": "string",
      "title": "Volunteer Name"
    },
    "module_title": {
      "type": "string",
      "title": "Training Module"
    },
    "training_provider": {
      "type": "string",
      "title": "Training Provider"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Completed Date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Expiry Date"
    },
    "score": {
      "type": "number",
      "title": "Score (%)"
    },
    "certificate_number": {
      "type": "string",
      "title": "Certificate Number"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "volunteer_id",
    "module_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    }
  }
}