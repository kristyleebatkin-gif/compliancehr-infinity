{
  "name": "EmployeeDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Resume",
        "Contract",
        "Police Check",
        "Blue Card",
        "First Aid Certificate",
        "CPR Certificate",
        "NDIS Worker Screening",
        "Driver's License",
        "Qualifications",
        "Reference Check",
        "Staff Badge",
        "Other"
      ],
      "default": "Other",
      "title": "Document Type"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "Issue Date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "title": "Expiry Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Current",
        "Expiring Soon",
        "Expired",
        "Archived"
      ],
      "default": "Current",
      "title": "Status"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "data.employee_name": "{{user.full_name}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "data.employee_name": "{{user.full_name}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "data.employee_name": "{{user.full_name}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}