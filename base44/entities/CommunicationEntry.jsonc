{
  "name": "CommunicationEntry",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "Shift Note",
        "Employee Log",
        "Message",
        "Email",
        "Broadcast",
        "Team Banter",
        "Video Call"
      ],
      "title": "Entry Kind"
    },
    "document_number": {
      "type": "string",
      "title": "Document Number"
    },
    "version": {
      "type": "string",
      "default": "v1.0",
      "title": "Version"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "site": {
      "type": "string",
      "title": "Site / Residence"
    },
    "program": {
      "type": "string",
      "title": "Program (NDIS / Aged Care)"
    },
    "security_classification": {
      "type": "string",
      "enum": [
        "Internal",
        "Confidential",
        "Restricted Clinical",
        "Executive Safe"
      ],
      "default": "Internal",
      "title": "Security Classification"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "Sent",
        "Delivered",
        "Read",
        "Acknowledged",
        "Responded",
        "Archived"
      ],
      "default": "Sent",
      "title": "6-Stage Communication Lifecycle Status"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "title": "Delivered Timestamp"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "title": "Read Timestamp"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Acknowledged Timestamp"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Responded Timestamp"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "title": "Archived Timestamp"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "Participant",
        "Employee",
        "General"
      ],
      "default": "General",
      "title": "Person Type"
    },
    "person_name": {
      "type": "string",
      "title": "Person Name"
    },
    "note_type": {
      "type": "string",
      "title": "Note Type"
    },
    "shift_type": {
      "type": "string",
      "title": "Shift Type"
    },
    "travel_km": {
      "type": "number",
      "title": "Travel (km)"
    },
    "travel_location": {
      "type": "string",
      "title": "Travel Location"
    },
    "goal": {
      "type": "string",
      "title": "Relevant Goal"
    },
    "medication_supervised": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ],
      "title": "Medication Supervised"
    },
    "log_type": {
      "type": "string",
      "title": "Log Type"
    },
    "attention": {
      "type": "string",
      "title": "Attention Line"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "body": {
      "type": "string",
      "title": "Communication"
    },
    "issues_concerns": {
      "type": "string",
      "title": "Issues or Concerns"
    },
    "incident_report": {
      "type": "string",
      "title": "Incident Report Reference"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "entry_time": {
      "type": "string",
      "title": "Time"
    },
    "staff_involved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Staff Involved"
    },
    "attachments_json": {
      "type": "string",
      "title": "Attachments (JSON)"
    },
    "send_copy_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Email Copies Sent To"
    },
    "management_copy": {
      "type": "boolean",
      "default": false,
      "title": "Copy Emailed to Management"
    },
    "recipients_json": {
      "type": "string",
      "title": "Recipients (JSON)"
    },
    "sender_name": {
      "type": "string",
      "title": "Sent By"
    },
    "sender_email": {
      "type": "string",
      "title": "Sender Email"
    },
    "module": {
      "type": "string",
      "title": "Module / Location"
    },
    "parent_id": {
      "type": "string",
      "title": "Reply To (Entry ID)"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "title": "Email Copy Sent"
    },
    "goal_note_created": {
      "type": "boolean",
      "default": false,
      "title": "Goal Progress Updated"
    },
    "employee_author_id": {
      "type": "string",
      "title": "Verified Employee Author",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    },
    "recipient_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Verified Recipients",
      "rls": {
        "write": {
          "user_condition": {
            "role": "__service_role_only__"
          }
        }
      }
    }
  },
  "required": [
    "entry_kind"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Rostering Coordinator"
              }
            },
            {
              "user_condition": {
                "role": "CRM & Marketing Officer"
              }
            },
            {
              "user_condition": {
                "role": "Intake Officer"
              }
            },
            {
              "user_condition": {
                "role": "Participant"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "$and": [
                {
                  "$nor": [
                    {
                      "user_condition": {
                        "role": "Employee"
                      }
                    }
                  ]
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Provider Administrator"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Compliance Manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Administration"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Team Leader"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Human Resources Manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Auditor"
                      }
                    },
                    {
                      "created_by_id": "{{user.id}}"
                    },
                    {
                      "data.sender_email": "{{user.email}}"
                    },
                    {
                      "data.recipient_emails": "{{user.email}}"
                    },
                    {
                      "data.entry_kind": {
                        "$in": [
                          "Broadcast",
                          "Team Banter",
                          "Video Call"
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "Employee"
                  }
                },
                {
                  "$or": [
                    {
                      "created_by_id": "{{user.id}}"
                    },
                    {
                      "data.employee_author_id": "{{user.id}}"
                    },
                    {
                      "data.sender_email": "{{user.email}}"
                    },
                    {
                      "data.recipient_emails": "{{user.email}}"
                    },
                    {
                      "data.entry_kind": "Team Banter"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "$and": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "$or": [
                    {
                      "user_condition": {
                        "role": "Management"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Team Leader"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Support Worker"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Human Resources Manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Rostering Coordinator"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "CRM & Marketing Officer"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Intake Officer"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Participant"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Quality & Improvement Manager"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Finance & Accounts Officer"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Auditor"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "Volunteer"
                      }
                    },
                    {
                      "user_condition": {
                        "role": "user"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
