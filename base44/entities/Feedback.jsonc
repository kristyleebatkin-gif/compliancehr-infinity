{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Feedback",
        "Complaint"
      ],
      "default": "Feedback",
      "title": "Type"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "submitted_by": {
      "type": "string",
      "title": "Submitted By"
    },
    "contact_details": {
      "type": "string",
      "title": "Contact Details"
    },
    "received_via": {
      "type": "string",
      "title": "Received Via (phone, email, in person, form)"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Received",
        "Viewed",
        "Pending Further Action",
        "Finalised"
      ],
      "default": "Received",
      "title": "Status"
    },
    "received_date": {
      "type": "string",
      "format": "date-time",
      "title": "Received At"
    },
    "viewed_date": {
      "type": "string",
      "format": "date-time",
      "title": "Viewed At"
    },
    "pending_date": {
      "type": "string",
      "format": "date-time",
      "title": "Pending Further Action At"
    },
    "finalised_date": {
      "type": "string",
      "format": "date-time",
      "title": "Finalised At"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome / Resolution"
    },
    "form_uri": {
      "type": "string",
      "title": "Feedback Form File URI"
    },
    "form_name": {
      "type": "string",
      "title": "Feedback Form File Name"
    },
    "status_log": {
      "type": "string",
      "title": "Status History"
    }
  },
  "required": [
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        }
      ]
    }
  }
}