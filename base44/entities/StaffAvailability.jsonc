{
  "name": "StaffAvailability",
  "type": "object",
  "properties": {
    "staff_name": {
      "type": "string",
      "title": "Staff Member"
    },
    "type": {
      "type": "string",
      "enum": [
        "Available",
        "Unavailable"
      ],
      "default": "Available",
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "title": "All Day"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "staff_name",
    "date"
  ]
}