{
  "name": "StaffAvailability",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "staff_name": {
      "type": "string",
      "title": "Staff Member"
    },
    "type": {
      "type": "string",
      "enum": [
        "Available",
        "Unavailable"
      ],
      "default": "Available",
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "title": "All Day"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "staff_name",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        }
      ]
    }
  }
}
