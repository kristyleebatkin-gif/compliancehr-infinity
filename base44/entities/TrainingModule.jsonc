{
  "name": "TrainingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Module Title"
    },
    "module_code": {
      "type": "string",
      "title": "Module Code"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "enum": [
        "Mandatory",
        "Compliance",
        "Clinical",
        "Professional Development",
        "Induction"
      ],
      "default": "Mandatory",
      "title": "Category"
    },
    "duration_hours": {
      "type": "number",
      "title": "Duration (Hours)"
    },
    "validity_months": {
      "type": "number",
      "title": "Validity (Months)"
    },
    "pass_mark": {
      "type": "number",
      "title": "Pass Mark (%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Archived"
      ],
      "default": "Active",
      "title": "Status"
    }
  },
  "required": [
    "title"
  ]
}