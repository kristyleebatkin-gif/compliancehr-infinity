{
  "name": "Checklist",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "category": {
      "type": "string",
      "title": "Checklist / Assessment Type",
      "default": "Compliance Checklists"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Draft",
        "In Progress",
        "Under Review",
        "Approved",
        "Action Required",
        "Completed"
      ],
      "default": "In Progress"
    },
    "outcome": {
      "type": "string",
      "title": "Assessment Outcome",
      "default": "Compliant"
    },
    "recommendations": {
      "type": "string",
      "title": "Recommendations"
    },
    "actions": {
      "type": "string",
      "title": "Follow-Up Actions"
    },
    "evidence_uri": {
      "type": "string",
      "title": "Evidence Private File URI"
    },
    "evidence_name": {
      "type": "string",
      "title": "Evidence File Name"
    },
    "reviewer": {
      "type": "string",
      "title": "Reviewer"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Review Date"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "title": "Approval Date"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Pending Approval",
        "Approved",
        "Changes Required"
      ],
      "default": "Approved",
      "title": "Approval Status"
    },
    "digital_signature": {
      "type": "string",
      "title": "Digital Signature"
    },
    "witness_signature": {
      "type": "string",
      "title": "Witness Digital Signature"
    },
    "signature_timestamp": {
      "type": "string",
      "title": "Signature Timestamp"
    },
    "participant_id": {
      "type": "string",
      "title": "Linked Participant ID"
    },
    "participant_name": {
      "type": "string",
      "title": "Linked Participant Name"
    },
    "employee_id": {
      "type": "string",
      "title": "Linked Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Linked Employee Name"
    },
    "ndis_compliant": {
      "type": "boolean",
      "default": true,
      "title": "NDIS Compliant"
    },
    "aged_care_compliant": {
      "type": "boolean",
      "default": true,
      "title": "Aged Care Compliant"
    },
    "items": {
      "type": "array",
      "title": "Checklist Items",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "user_condition": {
                "role": "Finance & Accounts Officer"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Rostering Coordinator"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "CRM & Marketing Officer"
              }
            },
            {
              "user_condition": {
                "role": "Intake Officer"
              }
            },
            {
              "user_condition": {
                "role": "Volunteer"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
