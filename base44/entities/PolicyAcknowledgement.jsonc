{
  "name": "PolicyAcknowledgement",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "policy_id": {
      "type": "string",
      "title": "Policy ID"
    },
    "policy_name": {
      "type": "string",
      "title": "Policy Name"
    },
    "policy_version": {
      "type": "string",
      "title": "Policy Version"
    },
    "staff_user_id": {
      "type": "string",
      "title": "Staff User ID"
    },
    "staff_name": {
      "type": "string",
      "title": "Staff Name"
    },
    "staff_email": {
      "type": "string",
      "format": "email",
      "title": "Staff Email"
    },
    "acknowledged_date": {
      "type": "string",
      "format": "date",
      "title": "Acknowledged On"
    }
  },
  "required": [
    "policy_id",
    "staff_name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "user_condition": {
                "role": "Finance & Accounts Officer"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Rostering Coordinator"
              }
            },
            {
              "user_condition": {
                "role": "CRM & Marketing Officer"
              }
            },
            {
              "user_condition": {
                "role": "Intake Officer"
              }
            },
            {
              "user_condition": {
                "role": "Volunteer"
              }
            },
            {
              "data.staff_user_id": "{{user.id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Quality & Improvement Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            },
            {
              "user_condition": {
                "role": "Team Leader"
              }
            },
            {
              "user_condition": {
                "role": "Support Worker"
              }
            },
            {
              "user_condition": {
                "role": "Finance & Accounts Officer"
              }
            },
            {
              "user_condition": {
                "role": "Human Resources Manager"
              }
            },
            {
              "user_condition": {
                "role": "Rostering Coordinator"
              }
            },
            {
              "user_condition": {
                "role": "CRM & Marketing Officer"
              }
            },
            {
              "user_condition": {
                "role": "Intake Officer"
              }
            },
            {
              "user_condition": {
                "role": "Volunteer"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
