{
  "name": "Audit",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "audit_area": {
      "type": "string",
      "title": "Audit Area"
    },
    "audit_type": {
      "type": "string",
      "enum": [
        "Internal",
        "NDIS Verification",
        "NDIS Certification",
        "NDIS Mid-term",
        "Other"
      ],
      "default": "Internal",
      "title": "Audit Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Audit Date"
    },
    "auditor": {
      "type": "string",
      "title": "Auditor"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Complete",
        "Follow-up Required"
      ],
      "default": "Scheduled",
      "title": "Status"
    },
    "score": {
      "type": "number",
      "title": "Score (%)"
    },
    "findings": {
      "type": "string",
      "title": "Findings"
    },
    "actions": {
      "type": "string",
      "title": "Corrective Actions"
    },
    "checklist_file_uri": {
      "type": "string",
      "title": "Checklist File URI"
    },
    "checklist_file_name": {
      "type": "string",
      "title": "Checklist File Name"
    },
    "report_file_uri": {
      "type": "string",
      "title": "Report File URI"
    },
    "report_file_name": {
      "type": "string",
      "title": "Report File Name"
    },
    "status_log": {
      "type": "string",
      "title": "Status History"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            },
            {
              "user_condition": {
                "role": "Administration"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "Provider Administrator"
              }
            },
            {
              "user_condition": {
                "role": "Compliance Manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            }
          ]
        }
      ]
    }
  }
}
