{
  "name": "VisualRoutine",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Routine Title"
    },
    "participant_name": {
      "type": "string",
      "title": "Participant"
    },
    "routine_date": {
      "type": "string",
      "format": "date",
      "title": "Routine Date"
    },
    "steps": {
      "type": "string",
      "title": "Steps (JSON)"
    },
    "created_by": {
      "type": "string",
      "title": "Created By"
    }
  },
  "required": [
    "title"
  ],
