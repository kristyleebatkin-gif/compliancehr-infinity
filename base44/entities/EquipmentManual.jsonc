{
  "name": "EquipmentManual",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Manual Title"
    },
    "equipment_name": {
      "type": "string",
      "title": "Equipment"
    },
    "category": {
      "type": "string",
      "enum": [
        "Office Equipment",
        "Electrical Equipment",
        "Garden Equipment",
        "Kitchen & Appliances",
        "Safety Equipment",
        "Vehicle",
        "Other"
      ],
      "default": "Office Equipment",
      "title": "Category"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "version": {
      "type": "string",
      "title": "Version"
    },
    "manual_url": {
      "type": "string",
      "title": "Manual Link"
    },
    "manual_file_uri": {
      "type": "string",
      "title": "Manual File URI"
    },
    "manual_file_name": {
      "type": "string",
      "title": "Manual File Name"
    },
    "operating_instructions": {
      "type": "string",
      "title": "Operating Instructions"
    },
    "maintenance_schedule": {
      "type": "string",
      "title": "Maintenance Schedule"
    },
    "safety_notes": {
      "type": "string",
      "title": "Safety Notes"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Next Review"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ]
}