{
  "name": "EquipmentManual",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Business (tenant) ID",
      "description": "Owning business. Set automatically; do not edit by hand."
    },
    "title": {
      "type": "string",
      "title": "Manual Title"
    },
    "equipment_name": {
      "type": "string",
      "title": "Equipment"
    },
    "category": {
      "type": "string",
      "enum": [
        "Office Equipment",
        "Electrical Equipment",
        "Garden Equipment",
        "Kitchen & Appliances",
        "Safety Equipment",
        "Vehicle",
        "Other"
      ],
      "default": "Office Equipment",
      "title": "Category"
    },
    "manufacturer": {
      "type": "string",
      "title": "Manufacturer"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "version": {
      "type": "string",
      "title": "Version"
    },
    "manual_url": {
      "type": "string",
      "title": "Manual Link"
    },
    "manual_file_uri": {
      "type": "string",
      "title": "Manual File URI"
    },
    "manual_file_name": {
      "type": "string",
      "title": "Manual File Name"
    },
    "operating_instructions": {
      "type": "string",
      "title": "Operating Instructions"
    },
    "maintenance_schedule": {
      "type": "string",
      "title": "Maintenance Schedule"
    },
    "safety_notes": {
      "type": "string",
      "title": "Safety Notes"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "Next Review"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Compliance Manager"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        },
        {
          "user_condition": {
            "role": "Team Leader"
          }
        },
        {
          "user_condition": {
            "role": "Support Worker"
          }
        },
        {
          "user_condition": {
            "role": "Finance & Accounts Officer"
          }
        },
        {
          "user_condition": {
            "role": "Human Resources Manager"
          }
        },
        {
          "user_condition": {
            "role": "Rostering Coordinator"
          }
        },
        {
          "user_condition": {
            "role": "Quality & Improvement Manager"
          }
        },
        {
          "user_condition": {
            "role": "CRM & Marketing Officer"
          }
        },
        {
          "user_condition": {
            "role": "Intake Officer"
          }
        },
        {
          "user_condition": {
            "role": "Participant"
          }
        },
        {
          "user_condition": {
            "role": "Auditor"
          }
        },
        {
          "user_condition": {
            "role": "Volunteer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Administration"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Provider Administrator"
          }
        }
      ]
    }
  }
}
